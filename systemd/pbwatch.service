[Unit]
Description=Pixel Buds monitor (pbwatch)
After=graphical-session.target bluetooth.target
Wants=bluetooth.target

[Service]
# Set --mac to your Pixel Buds Bluetooth address (run: bluetoothctl devices).
# To customise the trigger commands, override via:
#   systemctl --user edit pbwatch
# and add an [Service] block with your ExecStart, e.g.:
#   ExecStart=
#   ExecStart=/usr/local/bin/pbwatch --mac AB:CD:EF:01:23:45 --on-update "my-script" --on-disconnect "my-script --disconnected"
ExecStart=/usr/local/bin/pbwatch --mac YOUR_MAC_HERE
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target
