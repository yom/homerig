# pbwidget configuration — copy to ~/.pbwidget and edit.
# This file configures the display widget only. The monitor daemon (pbwatch)
# is configured via its --mac and --on-update CLI flags in the systemd service.

# Optional: Bluetooth MAC of your buds. Used only to look up the device name
# via BlueZ for the widget title. If unset, no title is shown unless DEVICE_LABEL is set.
# Run 'bluetoothctl devices' to find your MAC.
# DEVICE_MAC=""

DEVICE_LABEL=""                   # Label shown at the top of the widget.
                                  # Leave empty to use the Bluetooth device name (Device.Alias).
                                  # Example: DEVICE_LABEL="Pixel Buds"

BG_COLOR="#1e1e2e"                # gauge background
TEXT_COLOR="#cdd6f4"              # text and labels
ACCENT_COLOR="#89b4fa"            # active ANC mode highlight
RING_COLOR="#ffffff20"            # gauge track (8-digit hex = with alpha)
OPACITY=0.0                       # PNG background opacity (0=transparent)
AUTO_CLOSE=5000                   # ms until dunst dismisses (0=sticky)
IMAGE_SIZE=300                    # PNG width in px
ICON_THEME="Yaru"                 # icon theme for battery and ear icons
BATTERY_WARN=50                   # arc turns yellow below this %
BATTERY_CRITICAL=10               # arc turns red below this %
ANC_ADAPTIVE=auto                 # auto/true/false — show Adaptive ANC mode
