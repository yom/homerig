# ~/.config/dotfiles/local.env
# Copy this file to ~/.config/dotfiles/local.env and fill in your values.
# This file is NOT tracked by git — it contains machine-specific configuration.

VPN_GATEWAY="your.vpn.gateway.example.com"
VPN_GROUP="Your VPN Group Name"

# USB DAC audio device (usb-device-notify)
# Run 'lsusb' to find your DAC's vendor and product IDs (e.g. "262a:12c0").
# Run 'pactl list sinks short' to find exact sink names.
DAC_VENDOR_ID=""
DAC_PRODUCT_ID=""
DAC_SINK_NAME=""
SYSTEM_SINK_NAME=""

# Internal audio card name (laptop-dock.sh)
# Run 'pactl list cards short' and use the value from the "Name:" field.
AUDIO_CARD=""

# Bluetooth Pixel Buds MAC address (bt-device-notify)
# Run 'bluetoothctl devices' to find the MAC if different from the default.
BT_PIXEL_BUDS_MAC="AC:3E:B1:8E:4C:75"
