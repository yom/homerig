#!/bin/bash

_update_idesk_icon() {
    ln -sf "$HOME/.idesktop/$1" "$HOME/.idesktop/vpn-current.png"
    if /usr/bin/pgrep -x idesk > /dev/null; then
        /usr/bin/pkill -x idesk || true
        sleep 0.1
        /usr/bin/idesk &
    fi
}

LOCAL_ENV="$HOME/.config/dotfiles/local.env"
if [[ ! -f "$LOCAL_ENV" ]]; then
    dunstify -i "network-vpn-disconnected" "VPN error" "Missing $LOCAL_ENV"
    exit 1
fi
source "$LOCAL_ENV"

if [[ -z "${VPN_GATEWAY:-}" || -z "${VPN_GROUP:-}" ]]; then
    dunstify -i "network-vpn-disconnected" "VPN error" "VPN_GATEWAY or VPN_GROUP not set in $LOCAL_ENV"
    exit 1
fi

if /usr/bin/pgrep -x "gpclient" > /dev/null; then
    timeout 10 sudo gpclient disconnect
    ip link show tun0 &>/dev/null && sudo /usr/bin/ip route flush dev tun0 2>/dev/null || true
    _update_idesk_icon vpn-off.png
    dunstify -i "network-vpn-disconnected" "VPN disconnected 🔓"
else
    sudo gpclient connect "$VPN_GATEWAY" -g "$VPN_GROUP" --reconnect-timeout 10 \
        --browser '/usr/local/bin/chrome-profile-wrapper' &
    _update_idesk_icon vpn-on.png
    dunstify -i "network-vpn" "VPN connected 🔒"
fi
