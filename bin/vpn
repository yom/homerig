#!/bin/bash

_update_idesk_icon() {
    ln -sf "$HOME/.idesktop/$1" "$HOME/.idesktop/vpn-current.png"
    if /usr/bin/pgrep -x idesk > /dev/null; then
        /usr/bin/pkill -x idesk || true
        sleep 0.1
        /usr/bin/idesk &
    fi
}

LOCAL_ENV="$HOME/.config/dotfiles/local.env"
if [[ ! -f "$LOCAL_ENV" ]]; then
    dunstify -i "network-vpn-disconnected" "VPN error" "Missing $LOCAL_ENV"
    exit 1
fi
source "$LOCAL_ENV"

if [[ -z "${VPN_GATEWAY:-}" || -z "${VPN_GROUP:-}" ]]; then
    dunstify -i "network-vpn-disconnected" "VPN error" "VPN_GATEWAY or VPN_GROUP not set in $LOCAL_ENV"
    exit 1
fi

# Debounce double-clicks: ignore a second invocation within 5 seconds.
# Timestamp file (not flock) because the script exits immediately after
# backgrounding gpclient — flock would release before the second click arrives.
_LOCK=/tmp/vpn.lock
_NOW=$(date +%s)
if [ -f "$_LOCK" ] && [ $(( _NOW - $(cat "$_LOCK") )) -lt 2 ]; then
    exit 0
fi
echo "$_NOW" > "$_LOCK"

if /usr/bin/pgrep -x "gpclient" > /dev/null; then
    sudo gpclient disconnect
    _update_idesk_icon vpn-off.png
    dunstify -i "network-vpn-disconnected" "VPN disconnected 🔓"
else
    sudo gpclient connect "$VPN_GATEWAY" -g "$VPN_GROUP" --reconnect-timeout 10 \
        --browser '/usr/local/bin/chrome-profile-wrapper' &
    # Poll for the tun0 default route rather than using ip monitor, which does not
    # flush output reliably in a non-TTY background context.
    (
        for _ in $(seq 90); do
            if ip route show default 2>/dev/null | grep -q 'dev tun0'; then
                _update_idesk_icon vpn-on.png
                dunstify -i "network-vpn" "VPN connected 🔒"
                exit 0
            fi
            sleep 1
        done
    ) &
fi
