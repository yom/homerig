#!/bin/bash

# Validate function parameter
FUNC=$1
if [ -z "$FUNC" ]; then
    echo "Usage: $0 {inc|dec|mute}"
    exit 1
fi

# Check if required commands are available
if ! command -v pactl >/dev/null 2>&1; then
    echo "Error: pactl not found. Install PulseAudio: sudo apt install pulseaudio-utils"
    exit 1
fi

if ! command -v dunstify >/dev/null 2>&1; then
    echo "Error: dunstify not found. Install: sudo apt install dunst"
    exit 1
fi

# Check if PulseAudio is running
if ! pactl info >/dev/null 2>&1; then
    echo "Error: PulseAudio not running"
    exit 1
fi
STEP=2
SERVER_STRING=$(pactl info |grep "Server String" |cut -d ':' -f 2 |sed 's/^\ *//g' |sed 's/\/native//g')
# Get default sink (works regardless of whether audio is playing)
ACTIVE_SINK=$(pactl get-default-sink 2>/dev/null)

# Fallback to first available sink if get-default-sink fails
if [ -z "$ACTIVE_SINK" ]; then
    ACTIVE_SINK=$(pactl list short sinks | head -1 | cut -f2)
fi

# Verify we have a valid sink
if [ -z "$ACTIVE_SINK" ]; then
    echo "Error: No audio sinks found"
    exit 1
fi
# Get card description for the active sink
CARD_NAME=$(pactl list sinks | grep -A10 "Name: ${ACTIVE_SINK}" | grep "Description:" | cut -d':' -f2- | sed 's/^ *//')
export PULSE_RUNTIME_PATH="$SERVER_STRING"

function getProgressString() {
    # getProgressString <TOTAL ITEMS> <FILLED LOOK> <NOT FILLED LOOK> <STATUS>
    # For instance:
    # $ getProgressString 10 "#" "-" 50
    # #####-----
    # Note: if you want to use | in your progress bar string you need to change the delimiter in the sed commands

    ITEMS="$1" # The total number of items(the width of the bar)
    FILLED_ITEM="$2" # The look of a filled item 
    NOT_FILLED_ITEM="$3" # The look of a not filled item
    STATUS="$4" # The current progress status in percent

    # calculate how many items need to be filled and not filled
    FILLED_ITEMS=$(echo "((${ITEMS} * ${STATUS})/100 + 0.5) / 1" | bc)
    NOT_FILLED_ITEMS=$(echo "$ITEMS - $FILLED_ITEMS" | bc)

    # Assemble the bar string
    msg=$(printf "%${FILLED_ITEMS}s" | sed "s| |${FILLED_ITEM}|g")
    msg=${msg}$(printf "%${NOT_FILLED_ITEMS}s" | sed "s| |${NOT_FILLED_ITEM}|g")
    echo "$msg"
}

function getVolumeIcon() {
    # getVolumeIcon <VOLUME>

    VOLUME=$1

    if [ $VOLUME -eq 0 ] ; then
        echo audio-volume-muted
    elif [ $VOLUME -le 33 ] ; then
        echo audio-volume-low
    elif [ $VOLUME -le 66 ] ; then
        echo audio-volume-medium
    else
        echo audio-volume-high
    fi
}

case "x$FUNC" in
    "xinc")
        # Get current volume to check limits
        CURRENT_VOL=$(pactl get-sink-volume "$ACTIVE_SINK" 2>/dev/null | grep -oP '\d+%' | head -1 | tr -d '%')
        if [ -n "$CURRENT_VOL" ] && [ "$CURRENT_VOL" -le $((100 - STEP)) ]; then
            pactl set-sink-volume $ACTIVE_SINK +${STEP}%
        else
            pactl set-sink-volume $ACTIVE_SINK 100%
        fi
    ;;
    xdec)
        pactl set-sink-volume $ACTIVE_SINK -${STEP}%
    ;;
    "xmute")
        CUR=$(pactl list sinks \
            |grep -A10 "Name: ${ACTIVE_SINK}" \
            |grep "Mute:" \
            |awk '{ print $2 }' )
        if [ "x$CUR" == "xno" ] ; then
            pactl set-sink-mute $ACTIVE_SINK 1
            VOL=0
        else
            pactl set-sink-mute $ACTIVE_SINK 0
        fi
    ;;
    *)
        echo "Error: command not recognized"
    ;;
esac

# Get current volume with improved parsing
if [ "x$VOL" == "x" ]; then
    VOL=$(pactl get-sink-volume "$ACTIVE_SINK" 2>/dev/null | grep -oP '\d+%' | head -1 | tr -d '%')
    # Fallback to old method if get-sink-volume fails
    if [ -z "$VOL" ]; then
        VOL=$(pactl list sinks | grep -A10 "Name: ${ACTIVE_SINK}" | grep "Volume:" | grep -oP '\d+%' | head -1 | tr -d '%')
    fi
fi

dunstify -a volume \
    -r 555 \
    -i $(getVolumeIcon $VOL) \
    -h string:x-canonical-private-synchronous:volume \
    -t 2000 \
    "$CARD_NAME" \
    "<b>$(getProgressString 20 "─" "·" $VOL) ${VOL}%</b>"
