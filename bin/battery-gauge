#!/usr/bin/env python3
"""Battery arc gauge renderer.

Usage: battery-gauge <capacity> <status> [<ac_online>]
  capacity   integer 0-100
  status     Charging | Discharging | Full | Not charging
  ac_online  0 or 1 (optional)

Prints the absolute path of the rendered PNG to stdout.

Environment variable overrides (all optional):
  BATTERY_GAUGE_SIZE       image width/height in px  (default 220)
  BATTERY_GAUGE_BG         background hex color       (default #1e1e2e)
  BATTERY_GAUGE_TEXT       text/label hex color       (default #cdd6f4)
  BATTERY_GAUGE_RING       track ring hex color       (default #ffffff20)
  BATTERY_GAUGE_WARN       yellow threshold %         (default 50)
  BATTERY_GAUGE_CRITICAL   red threshold %            (default 10)
  BATTERY_GAUGE_ICON_THEME icon theme name            (default hicolor)
  BATTERY_GAUGE_CHARGING_COLOR  arc color when charging (e.g. #89b4fa)
"""

import math
import os
import sys

import cairo
import gi
gi.require_version('Rsvg', '2.0')
from gi.repository import Rsvg


# ── Copied verbatim from pbutils/bin/pbwidget ────────────────────────────────

GAP = math.radians(80)   # 80° opening at the top of each gauge ring

_icon_handles = {}


def hex_to_rgba(h, alpha=1.0):
    h = h.lstrip("#")
    if len(h) == 8:
        r, g, b, a = (int(h[i:i+2], 16) / 255 for i in (0, 2, 4, 6))
        return r, g, b, a * alpha
    r, g, b = (int(h[i:i+2], 16) / 255 for i in (0, 2, 4))
    return r, g, b, alpha


def _get_icon_handle(icon_name, icon_theme):
    key = (icon_name, icon_theme)
    if key not in _icon_handles:
        candidates = [
            f"/usr/share/icons/{icon_theme}-hidpi/status/48/{icon_name}.svg",
            f"/usr/share/icons/{icon_theme}-hidpi/status/32/{icon_name}.svg",
            f"/usr/share/icons/{icon_theme}-hidpi/status/24/{icon_name}.svg",
            f"/usr/share/icons/{icon_theme}/scalable/status/{icon_name}.svg",
            f"/usr/share/icons/{icon_theme}/symbolic/status/{icon_name}.svg",
            f"/usr/share/icons/{icon_theme}/status/symbolic/{icon_name}.svg",
            f"/usr/share/icons/{icon_theme}-hidpi/status/symbolic/{icon_name}.svg",
            f"/usr/share/icons/Yaru/scalable/status/{icon_name}.svg",
            f"/usr/share/icons/Adwaita/symbolic/status/{icon_name}.svg",
            f"/usr/share/icons/hicolor/scalable/status/{icon_name}.svg",
            f"/usr/share/icons/Yaru/scalable/status/battery-missing-symbolic.svg",
            f"/usr/share/icons/Adwaita/symbolic/status/battery-missing-symbolic.svg",
        ]
        _icon_handles[key] = None
        for path in candidates:
            if os.path.exists(path):
                try:
                    _icon_handles[key] = Rsvg.Handle.new_from_file(path)
                    break
                except Exception:
                    pass
    return _icon_handles[key]


def _battery_icon_name(pct, charging, icon_theme=""):
    if "elementary" in icon_theme.lower():
        if pct <= 0:
            return "battery-empty-charging" if charging else "battery-empty"
        if pct < 10:
            return "battery-caution-charging" if charging else "battery-caution"
        if pct < 50:
            return "battery-low-charging" if charging else "battery-low"
        if pct < 80:
            return "battery-good-charging" if charging else "battery-good"
        if charging:
            return "battery-full-charging"
        if pct >= 100:
            return "battery-full-charged"
        return "battery-full"
    if pct < 0:
        return "battery-missing-symbolic"
    level = round(pct / 10) * 10
    level = max(0, min(100, level))
    if charging:
        return f"battery-level-{level}-charging-symbolic"
    return f"battery-level-{level}-symbolic"


def draw_battery_icon(ctx, cx, cy, radius, pct, charging, icon_theme, arc_color, bg_rgba):
    icon_name = _battery_icon_name(pct, charging)
    handle = _get_icon_handle(icon_name, icon_theme)
    if handle is None:
        return

    dims = handle.get_intrinsic_dimensions()
    vb = dims.out_viewbox
    svg_w = vb.width  if vb.width  > 0 else 16.0
    svg_h = vb.height if vb.height > 0 else 16.0

    gap_chord = 2 * radius * math.sin(GAP / 2)
    icon_size = gap_chord * 0.36
    circle_r  = icon_size * 0.72

    icon_cx = cx
    icon_cy = cy - radius

    ctx.save()
    ctx.set_source_rgba(*arc_color)
    ctx.arc(icon_cx, icon_cy, circle_r, 0, 2 * math.pi)
    ctx.fill()
    ctx.restore()

    px = max(1, int(icon_size * svg_w / svg_h))
    py = max(1, int(icon_size))
    tmp = cairo.ImageSurface(cairo.FORMAT_ARGB32, px, py)
    tmp_ctx = cairo.Context(tmp)
    viewport = Rsvg.Rectangle()
    viewport.x, viewport.y, viewport.width, viewport.height = 0, 0, svg_w, svg_h
    tmp_ctx.scale(px / svg_w, py / svg_h)
    handle.render_document(tmp_ctx, viewport)

    ctx.save()
    ctx.set_source_rgba(*bg_rgba)
    ctx.mask_surface(tmp, icon_cx - px / 2, icon_cy - py / 2)
    ctx.restore()


# ── Center content: battery icon + percentage overlay ────────────────────────

def _render_svg_centered(ctx, handle, cx, cy, target_w, target_h):
    dims = handle.get_intrinsic_dimensions()
    vb = dims.out_viewbox
    svg_w = vb.width  if vb.width  > 0 else 16.0
    svg_h = vb.height if vb.height > 0 else 16.0

    aspect = svg_w / svg_h
    if aspect >= 1.0:
        pw = int(target_w)
        ph = max(1, int(target_w / aspect))
    else:
        ph = int(target_h)
        pw = max(1, int(target_h * aspect))

    tmp = cairo.ImageSurface(cairo.FORMAT_ARGB32, pw, ph)
    tmp_ctx = cairo.Context(tmp)
    viewport = Rsvg.Rectangle()
    viewport.x, viewport.y, viewport.width, viewport.height = 0, 0, svg_w, svg_h
    tmp_ctx.scale(pw / svg_w, ph / svg_h)
    handle.render_document(tmp_ctx, viewport)

    ctx.save()
    ctx.set_operator(cairo.OPERATOR_OVER)
    ctx.set_source_surface(tmp, cx - pw / 2, cy - ph / 2)
    ctx.paint()
    ctx.restore()


def draw_badge_percent(ctx, cx, cy, radius, pct, arc_color, bg_rgba):
    """Percentage text in a colored circle, centered in the top gap of the ring."""
    gap_chord = 2 * radius * math.sin(GAP / 2)
    icon_size = gap_chord * 0.36
    circle_r  = icon_size * 0.82

    icon_cx = cx
    icon_cy = cy - radius

    ctx.save()
    ctx.set_source_rgba(*arc_color)
    ctx.arc(icon_cx, icon_cy, circle_r, 0, 2 * math.pi)
    ctx.fill()
    ctx.restore()

    label = f"{pct}%"
    ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
    font_size = circle_r * 0.82
    ctx.set_font_size(font_size)
    ext = ctx.text_extents(label)
    while ext.width > circle_r * 1.72 and font_size > 4:
        font_size -= 0.5
        ctx.set_font_size(font_size)
        ext = ctx.text_extents(label)
    ctx.set_source_rgba(*bg_rgba)
    ctx.move_to(icon_cx - ext.width / 2 - ext.x_bearing,
                icon_cy - ext.height / 2 - ext.y_bearing)
    ctx.show_text(label)


def draw_center(ctx, cx, cy, radius, thickness, pct, charging, icon_theme, text_rgba, arc_color=None):
    inner_r = radius - thickness / 2 - 2

    icon_name = _battery_icon_name(pct, charging, icon_theme)
    is_symbolic = icon_name.endswith("-symbolic")

    gap_chord     = 2 * radius * math.sin(GAP / 2)
    icon_target_w = gap_chord * 0.75
    icon_target_h = gap_chord * 0.75
    icon_cy       = cy - radius * 0.38

    handle = _get_icon_handle(icon_name, icon_theme)
    if handle:
        dims = handle.get_intrinsic_dimensions()
        vb = dims.out_viewbox
        svg_w = vb.width  if vb.width  > 0 else 16.0
        svg_h = vb.height if vb.height > 0 else 16.0
        aspect = svg_w / svg_h
        if aspect >= 1.0:
            pw = int(icon_target_w)
            ph = max(1, int(icon_target_w / aspect))
        else:
            ph = int(icon_target_h)
            pw = max(1, int(icon_target_h * aspect))
        tmp = cairo.ImageSurface(cairo.FORMAT_ARGB32, pw, ph)
        tmp_ctx = cairo.Context(tmp)
        viewport = Rsvg.Rectangle()
        viewport.x, viewport.y, viewport.width, viewport.height = 0, 0, svg_w, svg_h
        tmp_ctx.scale(pw / svg_w, ph / svg_h)
        handle.render_document(tmp_ctx, viewport)
        ctx.save()
        if is_symbolic and arc_color:
            # Symbolic icons are monochrome — paint them using the arc color
            ctx.set_source_rgba(*arc_color)
            ctx.mask_surface(tmp, cx - pw / 2, icon_cy - ph / 2)
        else:
            # Colored icons — render with their natural colors intact
            ctx.set_source_surface(tmp, cx - pw / 2, icon_cy - ph / 2)
            ctx.paint()
        ctx.restore()

    # Percentage text below the icon
    label = f"{pct}%"
    ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
    font_size = inner_r * 0.35
    ctx.set_font_size(font_size)
    ext = ctx.text_extents(label)
    text_cy = cy + inner_r * 0.55
    ctx.set_source_rgba(*text_rgba)
    ctx.move_to(cx - ext.width / 2 - ext.x_bearing,
                text_cy - ext.height / 2 - ext.y_bearing)
    ctx.show_text(label)


# ── Main render ───────────────────────────────────────────────────────────────

def render(capacity, charging, output_path, cfg):
    W = H = cfg["SIZE"]
    surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, W, H)
    ctx = cairo.Context(surface)

    bg_rgba   = hex_to_rgba(cfg["BG"])
    text_rgba = hex_to_rgba(cfg["TEXT"])
    ring_rgba = hex_to_rgba(cfg["RING"])

    ctx.set_source_rgba(*bg_rgba)
    ctx.rectangle(0, 0, W, H)
    ctx.fill()

    radius    = W * 0.34
    thickness = max(4, W * 0.08)
    cx = W / 2
    cy = H * 0.50

    arc_color = hex_to_rgba(cfg.get("ARC_COLOR") or "#89b4fa")

    ring_start = -math.pi / 2 + GAP / 2
    ring_end   = -math.pi / 2 - GAP / 2 + 2 * math.pi

    ctx.set_line_cap(cairo.LINE_CAP_ROUND)
    ctx.set_line_width(thickness)

    ctx.set_source_rgba(*ring_rgba)
    ctx.new_sub_path()
    ctx.arc(cx, cy, radius, ring_start, ring_end)
    ctx.stroke()

    if capacity > 0:
        arc_span = 2 * math.pi - GAP
        ctx.set_source_rgba(*arc_color)
        ctx.new_sub_path()
        ctx.arc(cx, cy, radius, ring_start, ring_start + (capacity / 100) * arc_span)
        ctx.stroke()

    draw_center(ctx, cx, cy, radius, thickness, capacity, charging,
                cfg["ICON_THEME"], text_rgba, arc_color)

    surface.write_to_png(output_path)


# ── Entry point ───────────────────────────────────────────────────────────────

def main():
    if len(sys.argv) < 3:
        sys.stderr.write("Usage: battery-gauge <capacity> <status> [<ac_online>]\n")
        sys.exit(1)

    capacity = int(sys.argv[1])
    status   = sys.argv[2]
    charging = (status == "Charging")

    cfg = {
        "SIZE":            int(os.environ.get("BATTERY_GAUGE_SIZE",      "165")),
        "BG":              os.environ.get("BATTERY_GAUGE_BG",            "#1e1e2e"),
        "TEXT":            os.environ.get("BATTERY_GAUGE_TEXT",          "#cdd6f4"),
        "RING":            os.environ.get("BATTERY_GAUGE_RING",          "#ffffff20"),
        "WARN":            int(os.environ.get("BATTERY_GAUGE_WARN",      "50")),
        "CRITICAL":        int(os.environ.get("BATTERY_GAUGE_CRITICAL",  "10")),
        "ICON_THEME":      os.environ.get("BATTERY_GAUGE_ICON_THEME",    "elementary-xfce"),
        "ARC_COLOR":       os.environ.get("BATTERY_GAUGE_ARC_COLOR",     "#64baff"),
    }

    runtime_dir = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    output_dir  = os.path.join(runtime_dir, "battery-gauge")
    os.makedirs(output_dir, exist_ok=True)
    output_path = os.path.join(output_dir, "gauge.png")

    render(capacity, charging, output_path, cfg)
    print(output_path)


if __name__ == "__main__":
    main()
