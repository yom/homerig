#!/bin/bash
#
# bt-device-notify - Bluetooth device connection notifications
#
# Runs as a systemd user service. Monitors BlueZ D-Bus signals for the
# configured device and fires dunstify notifications on connect/disconnect.
#

NOTIFICATION_ID=801
NOTIFICATION_TIMEOUT=3000

# shellcheck disable=SC1090
[[ -f "$HOME/.pbwidget" ]] && source "$HOME/.pbwidget" 2>/dev/null

DEVICE_MAC="${DEVICE_MAC:-AC:3E:B1:8E:4C:75}"
MAC_PATH="dev_${DEVICE_MAC//:/_}"

in_our_signal=false
prev_line=""

dbus-monitor --system \
    "type='signal',sender='org.bluez',interface='org.freedesktop.DBus.Properties',member='PropertiesChanged'" \
    2>/dev/null \
| while IFS= read -r line; do
    # New signal — check if it's for our device
    if [[ "$line" == signal* ]]; then
        if [[ "$line" == *"$MAC_PATH"* ]]; then
            in_our_signal=true
        else
            in_our_signal=false
        fi
    fi

    if [[ "$in_our_signal" == true ]]; then
        if [[ "$prev_line" == *'"Connected"'* ]]; then
            if [[ "$line" == *"boolean true"* || "$line" == *"boolean false"* ]]; then
                if [[ "$line" == *"boolean true"* ]]; then
                    /usr/local/bin/pbwidget 2>/dev/null || \
                        dunstify -r "$NOTIFICATION_ID" -i bluetooth \
                            -t "$NOTIFICATION_TIMEOUT" \
                            "Pixel Buds Connected" "Pixel Buds Pro"
                    # Background: ensure BT audio is routed; self-heal if WirePlumber failed
                    {
                        _mac_under="${DEVICE_MAC//:/_}"
                        for _i in $(seq 1 15); do
                            pactl list sinks short 2>/dev/null \
                                | grep -q "bluez_output.${_mac_under}" && break
                            sleep 0.5
                        done
                        if ! pactl list sinks short 2>/dev/null \
                                | grep -q "bluez_output.${_mac_under}"; then
                            dunstify -r "$NOTIFICATION_ID" --appname "pbwidget" \
                                -i bluetooth-active -t "$NOTIFICATION_TIMEOUT" \
                                "Audio routing failed" "Restarting WirePlumber…"
                            systemctl --user restart wireplumber
                            sleep 2
                        fi
                        _sink=$(pactl list sinks short 2>/dev/null \
                                | awk "/bluez_output\.${_mac_under}/{print \$2}" | head -1)
                        _card=$(pactl list cards short 2>/dev/null \
                                | awk "/bluez_card\.${_mac_under}/{print \$2}" | head -1)
                        [[ -n "$_card" ]] && pactl set-card-profile "$_card" a2dp-sink 2>/dev/null
                        [[ -n "$_sink" ]] && pactl set-default-sink "$_sink" 2>/dev/null
                    } &
                else
                    /usr/local/bin/pbwidget --disconnected 2>/dev/null || \
                        dunstify -r "$NOTIFICATION_ID" \
                            --appname "pbwidget" \
                            -i bluetooth \
                            -t "$NOTIFICATION_TIMEOUT" \
                            "Pixel Buds Disconnected" ""
                fi
            fi
        fi
    fi

    prev_line="$line"
done
