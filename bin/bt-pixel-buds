#!/usr/bin/env python3
"""Pixel Buds daemon.

Keeps RFCOMM channel 2 open and:
  - fires the battery/ANC widget on connect
  - self-heals WirePlumber audio routing in the background
  - updates the widget on ANC state or bud placement changes
  - fires a disconnected notification when the connection drops
Reconnects automatically with 5 s backoff.
"""

import os
import re
import socket
import struct
import subprocess
import sys
import threading
import time
import dbus

RFCOMM_CH       = 2
RECONNECT_DELAY = 5
NOTIFICATION_ID = "801"
NOTIFICATION_TO = "3000"
ANC_STATES  = {0x80: "transparency", 0x40: "adaptive", 0x20: "off", 0x08: "noise_cancellation"}
_heal_lock  = threading.Lock()

_RUNTIME_DIR    = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"),
    "pbwidget"
)
ANC_STATE_FILE     = os.path.join(_RUNTIME_DIR, "anc")
BATTERY_STATE_FILE = os.path.join(_RUNTIME_DIR, "battery")

_KV_RE = re.compile(r'^([A-Z_][A-Z0-9_]*)=(.+?)(?:\s+#.*)?$')


DORMANT_INTERVAL = 5  # seconds between BlueZ Connected checks while dormant


def _is_bt_connected(mac):
    try:
        bus  = dbus.SystemBus()
        path = f"/org/bluez/hci0/dev_{mac.replace(':', '_')}"
        obj  = bus.get_object("org.bluez", path)
        props = dbus.Interface(obj, "org.freedesktop.DBus.Properties")
        return bool(props.Get("org.bluez.Device1", "Connected"))
    except dbus.DBusException:
        return False


def _wait_for_bt_connect(mac):
    while not _is_bt_connected(mac):
        time.sleep(DORMANT_INTERVAL)


def _load_mac():
    try:
        with open(os.path.expanduser("~/.pbwidget")) as f:
            for line in f:
                m = _KV_RE.match(line.strip())
                if m:
                    key = m.group(1)
                    val = m.group(2).strip('"\'').strip()
                    if key == "DEVICE_MAC" and val:
                        return val
    except OSError:
        pass
    print("bt-pixel-buds: DEVICE_MAC not set in ~/.pbwidget — run 'bluetoothctl devices' to find your MAC", flush=True)
    sys.exit(1)


# ── RFCOMM helpers ────────────────────────────────────────────────────────────

def _read_msg(sock):
    h = b""
    while len(h) < 4:
        chunk = sock.recv(4 - len(h))
        if not chunk:
            raise ConnectionError("connection closed")
        h += chunk
    length = struct.unpack(">H", h[2:4])[0]
    p = b""
    while len(p) < length:
        chunk = sock.recv(length - len(p))
        if not chunk:
            raise ConnectionError("connection closed")
        p += chunk
    return h[0], h[1], p


def _connect(mac):
    s = socket.socket(socket.AF_BLUETOOTH, socket.SOCK_STREAM, socket.BTPROTO_RFCOMM)
    s.settimeout(10)
    s.connect((mac, RFCOMM_CH))

    # Process the initial device-info burst rather than discarding it —
    # it contains battery and ANC state sent by the device on connect.
    s.settimeout(0.4)
    try:
        while True:
            g, c, p = _read_msg(s)
            if g == 0x03 and c == 0x03 and len(p) == 3:
                left_pct,  left_chg  = _decode_battery_byte(p[0])
                right_pct, right_chg = _decode_battery_byte(p[1])
                case_pct,  case_chg  = _decode_battery_byte(p[2])
                _write_battery_state(left_pct, left_chg, right_pct, right_chg,
                                     case_pct, case_chg)
            elif g == 0x08 and c == 0x13 and len(p) >= 4:
                state, supported = _decode_anc(p)
                if state:
                    _write_anc_state(state, supported)
    except (socket.timeout, ConnectionError):
        pass

    # Request current ANC state in case it wasn't in the burst.
    s.settimeout(10)
    s.send(bytes([0x08, 0x11, 0x00, 0x00]))
    s.settimeout(None)
    return s


# ── ANC decoding ──────────────────────────────────────────────────────────────

def _decode_anc(payload):
    state = next((v for k, v in ANC_STATES.items() if payload[3] & k), None)
    supported = [v for k, v in ANC_STATES.items() if len(payload) > 1 and payload[1] & k]
    return state, supported


def _write_anc_state(state, supported):
    with open(ANC_STATE_FILE, "w") as f:
        f.write(state + "\n" + ",".join(supported))


def _decode_battery_byte(b):
    return (-1 if (b & 0x7f) == 0x7f else (b & 0x7f)), bool(b >> 7)


def _write_battery_state(left, left_chg, right, right_chg, case, case_chg):
    with open(BATTERY_STATE_FILE, "w") as f:
        f.write(f"left={left}\nleft_charging={str(left_chg).lower()}\n"
                f"right={right}\nright_charging={str(right_chg).lower()}\n"
                f"case={case}\ncase_charging={str(case_chg).lower()}\n")


# ── Widget triggers ───────────────────────────────────────────────────────────

def _trigger_widget():
    subprocess.Popen(["/usr/local/bin/pbwidget"],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def _trigger_disconnected():
    subprocess.Popen(["/usr/local/bin/pbwidget", "--disconnected"],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ── WirePlumber audio healing (runs in a background thread on connect) ────────

def _heal_audio(mac):
    if not _heal_lock.acquire(blocking=False):
        return
    try:
        mac_under = mac.replace(":", "_")

        def _sinks():
            return subprocess.run(["pactl", "list", "sinks", "short"],
                                  capture_output=True, text=True).stdout

        # Poll up to 7.5 s for WirePlumber to register the BT sink.
        for _ in range(15):
            if f"bluez_output.{mac_under}" in _sinks():
                break
            time.sleep(0.5)
        else:
            # Sink never appeared — WirePlumber's A2DP transport negotiation failed.
            subprocess.run(["dunstify", "-r", NOTIFICATION_ID, "--appname", "pbwidget",
                            "-i", "bluetooth-active", "-t", NOTIFICATION_TO,
                            "Audio routing failed", "Restarting WirePlumber…"],
                           check=False)
            subprocess.run(["systemctl", "--user", "restart", "wireplumber"], check=False)
            time.sleep(2)

        sinks_out = _sinks()
        cards_out = subprocess.run(["pactl", "list", "cards", "short"],
                                   capture_output=True, text=True).stdout

        sink = next((l.split()[1] for l in sinks_out.splitlines()
                     if f"bluez_output.{mac_under}" in l), None)
        card = next((l.split()[1] for l in cards_out.splitlines()
                     if f"bluez_card.{mac_under}" in l), None)

        if card:
            # Only switch profile if not already A2DP — avoids tearing down a
            # working transport and causing an audible glitch on every reconnect.
            profile_out = subprocess.run(["pactl", "list", "cards"],
                                         capture_output=True, text=True).stdout
            in_card, current_profile = False, ""
            for line in profile_out.splitlines():
                if card in line:
                    in_card = True
                if in_card and "Active Profile:" in line:
                    current_profile = line.split(":", 1)[1].strip()
                    break
            if current_profile != "a2dp-sink":
                subprocess.run(["pactl", "set-card-profile", card, "a2dp-sink"],
                               check=False, capture_output=True)

        if sink:
            default_sink = subprocess.run(["pactl", "get-default-sink"],
                                          capture_output=True, text=True).stdout.strip()
            if default_sink != sink:
                subprocess.run(["pactl", "set-default-sink", sink],
                               check=False, capture_output=True)
    finally:
        _heal_lock.release()


# ── Main loop ─────────────────────────────────────────────────────────────────

def run(mac, debug=False):
    os.makedirs(_RUNTIME_DIR, exist_ok=True)
    last_state         = None
    last_placement     = None
    last_charging      = None  # (left_chg, right_chg, case_chg)
    drop_count         = 0     # consecutive failures; notification fires at 2
    ever_connected     = False  # guards against spurious startup notifications
    sock               = None
    print(f"bt-pixel-buds: monitoring {mac}{' [DEBUG]' if debug else ''}", flush=True)

    # Start dormant if the device isn't reachable yet — avoids two pointless
    # RFCOMM attempts before the dormant loop would kick in anyway.
    if not _is_bt_connected(mac):
        _wait_for_bt_connect(mac)

    while True:
        try:
            print("bt-pixel-buds: connecting...", flush=True)
            # Clear stale state before connecting so the burst processing in
            # _connect() writes fresh data into clean files.
            for path in (BATTERY_STATE_FILE, ANC_STATE_FILE):
                try:
                    os.remove(path)
                except OSError:
                    pass

            sock = _connect(mac)
            ever_connected = True

            # Reconnect succeeded — if there was a pending drop, it was transient.
            if drop_count > 0:
                drop_count = 0
                print("bt-pixel-buds: reconnected", flush=True)
            else:
                print("bt-pixel-buds: connected", flush=True)

            last_state     = None
            last_placement = None
            last_charging  = None

            # Fire the widget immediately — _connect() already processed the
            # initial burst so battery/ANC state files are populated.
            _trigger_widget()
            threading.Thread(target=_heal_audio, args=(mac,), daemon=True).start()

            while True:
                g, c, p = _read_msg(sock)

                if debug:
                    print(f"  msg group=0x{g:02x} code=0x{c:02x} len={len(p)}"
                          f"  payload={p.hex()}", flush=True)

                if g == 0x08 and c == 0x13 and len(p) >= 4:
                    state, supported = _decode_anc(p)
                    if state:
                        _write_anc_state(state, supported)
                    if state and state != last_state:
                        last_state = state
                        print(f"bt-pixel-buds: ANC → {state} (supported: {supported})",
                              flush=True)
                        _trigger_widget()

                elif g == 0x03 and c == 0x03 and len(p) == 3:
                    left_pct,  left_chg  = _decode_battery_byte(p[0])
                    right_pct, right_chg = _decode_battery_byte(p[1])
                    case_pct,  case_chg  = _decode_battery_byte(p[2])
                    _write_battery_state(left_pct, left_chg, right_pct, right_chg,
                                         case_pct, case_chg)

                    placement = (left_pct == -1, right_pct == -1)
                    charging  = (left_chg, right_chg, case_chg)

                    if placement != last_placement:
                        last_placement = placement
                        left_s  = "in case" if placement[0] else "out"
                        right_s = "in case" if placement[1] else "out"
                        print(f"bt-pixel-buds: placement → left={left_s} right={right_s}",
                              flush=True)
                        _trigger_widget()
                    elif charging != last_charging:
                        print(f"bt-pixel-buds: charging → {charging}", flush=True)
                        _trigger_widget()

                    last_charging = charging

        except Exception as e:
            if sock is not None:
                try:
                    sock.close()
                except Exception:
                    pass

            if isinstance(e, ConnectionResetError):
                # Intentional firmware reset — the device signals state changes
                # (bud in/out of case) by tearing down RFCOMM. Not a failure.
                print("bt-pixel-buds: device reset (state change), reconnecting…",
                      flush=True)
                time.sleep(0.5)
                continue

            print(f"bt-pixel-buds: {e} — retrying in {RECONNECT_DELAY}s", flush=True)

            drop_count += 1
            if drop_count == 2 and ever_connected:
                # One reconnect attempt already failed — buds are genuinely gone.
                _trigger_disconnected()

            if drop_count >= 2:
                # Dormant: BlueZ says the device isn't connected — no point
                # hammering RFCOMM. Poll quietly until it reappears.
                _wait_for_bt_connect(mac)
            else:
                time.sleep(RECONNECT_DELAY)


if __name__ == "__main__":
    run(_load_mac(), debug="--debug" in sys.argv)
