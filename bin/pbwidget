#!/usr/bin/env python3
"""Pixel Buds battery + ANC status widget — renders a PNG and fires a dunst notification."""

import json
import math
import os
import re
import socket
import struct
import subprocess
import sys
import tempfile
import cairo
import gi
gi.require_version('Rsvg', '2.0')
from gi.repository import Rsvg

# ── Constants ────────────────────────────────────────────────────────────────

_RUNTIME_DIR   = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"),
    "pbwidget"
)
OUTPUT_PATH        = os.path.join(_RUNTIME_DIR, "widget.png")
ANC_STATE_FILE     = os.path.join(_RUNTIME_DIR, "anc")
BATTERY_STATE_FILE = os.path.join(_RUNTIME_DIR, "battery")
RFCOMM_CH      = 2
ANC_STATES     = {0x80: "transparency", 0x40: "adaptive", 0x20: "off", 0x08: "noise_cancellation"}
GAUGE_LABELS  = [("left", "L"), ("case", "C"), ("right", "R")]
ANC_MODES     = [
    ("noise_cancellation", "Noise cancellation"),
    ("off",                "Off"),
    ("adaptive",           "Adaptive"),
    ("transparency",       "Transparency"),
]

EAR_ICON_NAME = "hearing-symbolic"
EAR_ICON_SUBDIR = "org.gnome.Settings"

# ── Config ───────────────────────────────────────────────────────────────────

_KV_RE = re.compile(r'^([A-Z_][A-Z0-9_]*)=(.+?)(?:\s+#.*)?$')

def _parse_env_file(path):
    result = {}
    try:
        with open(os.path.expanduser(path)) as f:
            for line in f:
                m = _KV_RE.match(line.strip())
                if m:
                    result[m.group(1)] = m.group(2).strip('"\'').strip()
    except OSError:
        pass
    return result

def load_config():
    cfg = _parse_env_file("~/.pbwidget")

    mac = cfg.get("DEVICE_MAC") or "AC:3E:B1:8E:4C:75"

    def _int(key, default):
        try:
            return int(cfg.get(key, str(default)))
        except (ValueError, TypeError):
            return default

    def _float(key, default):
        try:
            return float(cfg.get(key, str(default)))
        except (ValueError, TypeError):
            return default

    warn     = _int("BATTERY_WARN",     50)
    critical = _int("BATTERY_CRITICAL", 10)
    if critical >= warn:
        critical = max(0, warn - 1)

    return {
        "DEVICE_MAC":   mac,
        "BG_COLOR":     cfg.get("BG_COLOR",    "#1e1e2e"),
        "TEXT_COLOR":   cfg.get("TEXT_COLOR",   "#cdd6f4"),
        "ACCENT_COLOR": cfg.get("ACCENT_COLOR", "#89b4fa"),
        "RING_COLOR":   cfg.get("RING_COLOR",   "#ffffff20"),
        "OPACITY":      _float("OPACITY",    0.0),
        "AUTO_CLOSE":   _int("AUTO_CLOSE",   5000),
        "IMAGE_SIZE":   max(100, _int("IMAGE_SIZE", 300)),
        "SPRITES_DIR":  os.path.expanduser("~/.local/share/pbwidget"),
        "ICON_THEME":        cfg.get("ICON_THEME", "Yaru"),
        "BATTERY_WARN":      warn,
        "BATTERY_CRITICAL":  critical,
        "ANC_ADAPTIVE":      cfg.get("ANC_ADAPTIVE", "auto").lower(),
    }

# ── Battery query ─────────────────────────────────────────────────────────────

def _lookup_device_name(device_mac):
    try:
        out = subprocess.check_output(["bluetoothctl", "devices"],
                                      stderr=subprocess.DEVNULL, text=True)
        for line in out.splitlines():
            if device_mac and device_mac.upper() in line.upper():
                return re.sub(r'^Device\s+\S+\s+', '', line).strip()
        for line in out.splitlines():
            if "pixel bud" in line.lower():
                return re.sub(r'^Device\s+\S+\s+', '', line).strip()
    except Exception:
        pass
    return ""

def _read_battery_state():
    try:
        with open(BATTERY_STATE_FILE) as f:
            kv = {k: v for k, _, v in (l.strip().partition("=") for l in f) if k}
        return {
            "left":           int(kv.get("left", -1)),
            "left_charging":  kv.get("left_charging") == "true",
            "right":          int(kv.get("right", -1)),
            "right_charging": kv.get("right_charging") == "true",
            "case":           int(kv.get("case", -1)),
            "case_charging":  kv.get("case_charging") == "true",
        }
    except (OSError, ValueError):
        return None


def _extract_pct(line):
    m = re.search(r':\s*(\d+)%', line)
    return int(m.group(1)) if m else -1

def _extract_charging(line):
    return "(charging)" in line and "(not charging)" not in line

def query_battery(device_mac):
    data = {"left": -1, "case": -1, "right": -1,
            "left_charging": False, "case_charging": False, "right_charging": False,
            "device_name": "", "anc": "unknown"}

    battery = _read_battery_state()
    if battery:
        data.update(battery)
    else:
        # Fallback: call pbpctrl if the daemon isn't running
        pbpctrl = os.path.expanduser("~/.cargo/bin/pbpctrl")
        try:
            out = subprocess.check_output([pbpctrl, "show", "battery"],
                                          stderr=subprocess.DEVNULL, text=True)
            for line in out.splitlines():
                if line.startswith("left bud:"):
                    data["left"] = _extract_pct(line)
                    data["left_charging"] = _extract_charging(line)
                elif line.startswith("right bud:"):
                    data["right"] = _extract_pct(line)
                    data["right_charging"] = _extract_charging(line)
                elif line.startswith("case:"):
                    data["case"] = _extract_pct(line)
                    data["case_charging"] = _extract_charging(line)
        except Exception:
            pass

    data["device_name"] = _lookup_device_name(device_mac)
    return data

# ── ANC query ─────────────────────────────────────────────────────────────────

def _read_rfcomm_msg(sock):
    h = b""
    while len(h) < 4:
        chunk = sock.recv(4 - len(h))
        if not chunk:
            raise ConnectionError("closed")
        h += chunk
    length = struct.unpack(">H", h[2:4])[0]
    p = b""
    while len(p) < length:
        chunk = sock.recv(length - len(p))
        if not chunk:
            raise ConnectionError("closed")
        p += chunk
    return h[0], h[1], p

_ALL_ANC_MODES = {"noise_cancellation", "transparency", "adaptive", "off"}

def query_anc(mac):
    # Prefer the state file written by bt-pixel-buds-anc (which holds the RFCOMM
    # connection), falling back to a direct query when the daemon isn't running.
    # Returns (state, supported_modes_set).
    try:
        with open(ANC_STATE_FILE) as f:
            lines = f.read().strip().splitlines()
        state = lines[0] if lines else "unknown"
        has_caps = len(lines) > 1 and lines[1].strip()
        supported = set(lines[1].split(",")) & _ALL_ANC_MODES if has_caps else None
        if state in _ALL_ANC_MODES:
            return state, supported
    except OSError:
        pass

    try:
        s = socket.socket(socket.AF_BLUETOOTH, socket.SOCK_STREAM, socket.BTPROTO_RFCOMM)
        s.settimeout(3)
        s.connect((mac, RFCOMM_CH))
        s.settimeout(0.4)
        try:
            while True:
                _read_rfcomm_msg(s)
        except (socket.timeout, ConnectionError):
            pass
        s.settimeout(3)
        s.send(bytes([0x08, 0x11, 0x00, 0x00]))
        g, c, p = _read_rfcomm_msg(s)
        s.close()
        if g == 0x08 and c == 0x13 and len(p) >= 4:
            state = next((v for k, v in ANC_STATES.items() if p[3] & k), "unknown")
            supported = {v for k, v in ANC_STATES.items() if len(p) > 1 and p[1] & k}
            return state, supported if supported else None
    except Exception:
        pass
    return "unknown", None

# ── Rendering ─────────────────────────────────────────────────────────────────

def hex_to_rgba(h, alpha=1.0):
    h = h.lstrip("#")
    if len(h) == 8:
        r, g, b, a = (int(h[i:i+2], 16) / 255 for i in (0, 2, 4, 6))
        return r, g, b, a * alpha
    r, g, b = (int(h[i:i+2], 16) / 255 for i in (0, 2, 4))
    return r, g, b, alpha


def load_sprites(sprites_dir):
    try:
        surface = cairo.ImageSurface.create_from_png(f"{sprites_dir}/sprites.png")
        with open(f"{sprites_dir}/sprites.json") as f:
            manifest = json.load(f)
        return surface, manifest
    except Exception:
        return None, {}


def draw_sprite(ctx, sprite_surface, sprite, cx, cy, scale=1.0):
    x, y, w, h = sprite["x"], sprite["y"], sprite["w"], sprite["h"]
    dw, dh = w * scale, h * scale
    ctx.save()
    ctx.translate(cx - dw / 2, cy - dh / 2)
    ctx.scale(scale, scale)
    ctx.set_source_surface(sprite_surface, -x, -y)
    ctx.rectangle(0, 0, w, h)
    ctx.fill()
    ctx.restore()


GAP = math.radians(80)  # 80° opening at top of each gauge ring

_icon_handles = {}

def _get_icon_handle(icon_name, icon_theme):
    key = (icon_name, icon_theme)
    if key not in _icon_handles:
        path = f"/usr/share/icons/{icon_theme}/scalable/status/{icon_name}.svg"
        if not os.path.exists(path):
            path = f"/usr/share/icons/{icon_theme}/scalable/status/battery-missing-symbolic.svg"
        try:
            _icon_handles[key] = Rsvg.Handle.new_from_file(path)
        except Exception:
            _icon_handles[key] = None
    return _icon_handles[key]


def _battery_icon_name(pct, charging):
    if pct < 0:
        return "battery-missing-symbolic"
    level = round(pct / 10) * 10
    level = max(0, min(100, level))
    if charging:
        return f"battery-level-{level}-charging-symbolic"
    return f"battery-level-{level}-symbolic"


def draw_battery_icon(ctx, cx, cy, radius, pct, charging, icon_theme, arc_color, bg_rgba):
    icon_name = _battery_icon_name(pct, charging)
    handle = _get_icon_handle(icon_name, icon_theme)
    if handle is None:
        return

    dims = handle.get_intrinsic_dimensions()
    vb = dims.out_viewbox
    svg_w = vb.width if vb.width > 0 else 16.0
    svg_h = vb.height if vb.height > 0 else 16.0

    gap_chord = 2 * radius * math.sin(GAP / 2)
    icon_size = gap_chord * 0.36
    circle_r  = icon_size * 0.72

    icon_cx = cx
    icon_cy = cy - radius

    # Filled circle in arc color
    ctx.save()
    ctx.set_source_rgba(*arc_color)
    ctx.arc(icon_cx, icon_cy, circle_r, 0, 2 * math.pi)
    ctx.fill()
    ctx.restore()

    # Render SVG at icon size
    px = max(1, int(icon_size * svg_w / svg_h))
    py = max(1, int(icon_size))
    tmp = cairo.ImageSurface(cairo.FORMAT_ARGB32, px, py)
    tmp_ctx = cairo.Context(tmp)
    viewport = Rsvg.Rectangle()
    viewport.x, viewport.y, viewport.width, viewport.height = 0, 0, svg_w, svg_h
    tmp_ctx.scale(px / svg_w, py / svg_h)
    handle.render_document(tmp_ctx, viewport)

    # Tint icon with bg color so it reads as inverted against the circle
    ctx.save()
    ctx.set_source_rgba(*bg_rgba)
    ctx.mask_surface(tmp, icon_cx - px / 2, icon_cy - py / 2)
    ctx.restore()


def _draw_unknown_gauge(ctx, cx, cy, radius, thickness, label, ring, text_color):
    ctx.set_line_cap(cairo.LINE_CAP_ROUND)
    ctx.set_line_width(thickness)
    ring_start = -math.pi / 2 + GAP / 2
    ring_end   = -math.pi / 2 - GAP / 2 + 2 * math.pi
    ctx.set_source_rgba(*ring)
    ctx.new_sub_path()
    ctx.arc(cx, cy, radius, ring_start, ring_end)
    ctx.stroke()
    ctx.set_source_rgba(*text_color)
    ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
    ctx.set_font_size(radius * 0.60)
    ext = ctx.text_extents(label)
    ctx.move_to(cx - ext.width / 2 - ext.x_bearing, cy - ext.height / 2 - ext.y_bearing)
    ctx.show_text(label)
    ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)


def draw_gauge(ctx, cx, cy, radius, thickness, pct, key, label,
               ring, text_color, bg_rgba, sprite_surface, manifest, charging,
               icon_theme="Yaru", battery_warn=50, battery_critical=10):
    ctx.set_line_cap(cairo.LINE_CAP_ROUND)
    ctx.set_line_width(thickness)

    if pct < 0:
        return  # unknown — draw nothing

    if pct < battery_critical:
        arc_color = (0.90, 0.20, 0.20, 1.0)   # red
    elif pct < battery_warn:
        arc_color = (0.95, 0.75, 0.10, 1.0)   # yellow
    else:
        arc_color = (0.30, 0.80, 0.35, 1.0)   # green

    # Background ring — open arc, gap centered at top (12 o'clock)
    ring_start = -math.pi / 2 + GAP / 2
    ring_end   = -math.pi / 2 - GAP / 2 + 2 * math.pi
    ctx.set_source_rgba(*ring)
    ctx.new_sub_path()
    ctx.arc(cx, cy, radius, ring_start, ring_end)
    ctx.stroke()

    if pct > 0:
        arc_span = (2 * math.pi - GAP)
        start = ring_start
        end = start + (pct / 100) * arc_span
        ctx.set_source_rgba(*arc_color)
        ctx.new_sub_path()
        ctx.arc(cx, cy, radius, start, end)
        ctx.stroke()

    if sprite_surface is not None and key in manifest:
        sprite = manifest[key]
        inner = (radius - thickness / 2) * 2
        scale = (inner * 0.75) / max(sprite["w"], sprite["h"])
        draw_sprite(ctx, sprite_surface, sprite, cx, cy, scale)
    else:
        ctx.set_source_rgba(*text_color)
        ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        ctx.set_font_size(radius * 0.60)
        ext = ctx.text_extents(label)
        ctx.move_to(cx - ext.width / 2 - ext.x_bearing, cy - ext.height / 2 - ext.y_bearing)
        ctx.show_text(label)

    draw_battery_icon(ctx, cx, cy, radius, pct, charging, icon_theme, arc_color, bg_rgba)


def draw_ear(ctx, cx, cy, r, icon_theme="Yaru"):
    key = ("ear", icon_theme)
    if key not in _icon_handles:
        path = f"/usr/share/icons/{icon_theme}/scalable/{EAR_ICON_SUBDIR}/{EAR_ICON_NAME}.svg"
        try:
            _icon_handles[key] = Rsvg.Handle.new_from_file(path)
        except Exception:
            _icon_handles[key] = None
    handle = _icon_handles[key]
    if handle is None:
        return
    dims = handle.get_intrinsic_dimensions()
    vb = dims.out_viewbox
    svg_w = vb.width if vb.width > 0 else 16.0
    svg_h = vb.height if vb.height > 0 else 16.0

    icon_size = r * 1.4
    px = max(1, int(icon_size))

    tmp = cairo.ImageSurface(cairo.FORMAT_ARGB32, px, px)
    tmp_ctx = cairo.Context(tmp)
    viewport = Rsvg.Rectangle()
    viewport.x, viewport.y, viewport.width, viewport.height = 0, 0, svg_w, svg_h
    tmp_ctx.scale(px / svg_w, px / svg_h)
    handle.render_document(tmp_ctx, viewport)

    r_col, g_col, b_col, a_col = ctx.get_source().get_rgba()
    ctx.save()
    ctx.set_source_rgba(r_col, g_col, b_col, a_col)
    ctx.mask_surface(tmp, cx - icon_size / 2, cy - icon_size / 2)
    ctx.restore()


def draw_anc_icon(ctx, cx, cy, r, mode_key, active_key, accent_rgba, text_rgba, icon_theme="Yaru"):
    is_active = mode_key == active_key
    color = accent_rgba if is_active else (*text_rgba[:3], 0.30)

    lw = max(1.5, r * 0.10)
    ctx.set_line_width(lw)
    ctx.set_line_cap(cairo.LINE_CAP_ROUND)
    ctx.set_source_rgba(*color)

    if mode_key == "noise_cancellation":
        ctx.set_dash([])
        ctx.new_sub_path()
        ctx.arc(cx, cy, r, 0, 2 * math.pi)
        ctx.stroke()

    elif mode_key == "off":
        unit = r * 0.35
        ctx.set_dash([unit, unit * 0.65])
        ctx.new_sub_path()
        ctx.arc(cx, cy, r, 0, 2 * math.pi)
        ctx.stroke()
        ctx.set_dash([])

    elif mode_key == "transparency":
        unit = r * 0.18
        ctx.set_dash([unit, unit * 0.9])
        ctx.new_sub_path()
        ctx.arc(cx, cy, r, 0, 2 * math.pi)
        ctx.stroke()
        ctx.set_dash([])

    elif mode_key == "adaptive":
        ctx.set_dash([])
        ctx.new_sub_path()
        ctx.arc(cx, cy, r, math.pi, 2 * math.pi)
        ctx.stroke()
        unit = r * 0.30
        ctx.set_dash([unit, unit * 0.65])
        ctx.new_sub_path()
        ctx.arc(cx, cy, r, 0, math.pi)
        ctx.stroke()
        ctx.set_dash([])

        star_cx, star_cy = cx + r * 0.72, cy - r * 0.72
        sr = r * 0.46
        sw = sr * 0.30
        ctx.set_line_width(0)
        for angle in (0, math.pi / 2):
            ctx.save()
            ctx.translate(star_cx, star_cy)
            ctx.rotate(angle)
            ctx.new_path()
            ctx.move_to(0, -sr)
            ctx.curve_to( sw, -sw,  sw,  sw, 0,  sr)
            ctx.curve_to(-sw,  sw, -sw, -sw, 0, -sr)
            ctx.close_path()
            ctx.fill()
            ctx.restore()

    ctx.set_source_rgba(*color)
    ctx.set_line_width(lw * 0.9)
    draw_ear(ctx, cx, cy, r, icon_theme)
    ctx.stroke()


def draw_anc_row(ctx, W, anc_y, anc_h, active_key, accent_rgba, text_rgba,
                 icon_theme="Yaru", supported_modes=None):
    modes = [(k, l) for k, l in ANC_MODES if supported_modes is None or k in supported_modes]
    n = len(modes)
    if n == 0:
        return
    cell = W // n
    icon_r = anc_h * 0.28
    icon_cy = anc_y + anc_h * 0.42
    max_w = cell * 0.92

    # Pick a font size where the longest label fits in bold on one line
    label_font = max(6, anc_h * 0.14)
    longest = max(modes, key=lambda m: len(m[1]))[1]
    ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
    ctx.set_font_size(label_font)
    while ctx.text_extents(longest).width > max_w and label_font > 6:
        label_font -= 0.5
        ctx.set_font_size(label_font)

    for i, (mode_key, mode_label) in enumerate(modes):
        cx = cell * i + cell / 2
        draw_anc_icon(ctx, cx, icon_cy, icon_r, mode_key, active_key, accent_rgba, text_rgba, icon_theme)

        color = accent_rgba if mode_key == active_key else (*text_rgba[:3], 0.30)
        ctx.set_source_rgba(*color)
        ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL,
                             cairo.FONT_WEIGHT_BOLD if mode_key == active_key
                             else cairo.FONT_WEIGHT_NORMAL)
        ctx.set_font_size(label_font)
        lines = [mode_label]

        label_y = icon_cy + icon_r + anc_h * 0.10
        line_h = label_font * 1.3
        for j, line in enumerate(lines):
            ext = ctx.text_extents(line)
            ctx.move_to(cx - ext.width / 2 - ext.x_bearing,
                        label_y + j * line_h - ext.y_bearing)
            ctx.show_text(line)


def render(data, cfg):
    size   = cfg["IMAGE_SIZE"]
    bg     = cfg["BG_COLOR"]
    text   = cfg["TEXT_COLOR"]
    accent = cfg["ACCENT_COLOR"]
    ring   = cfg["RING_COLOR"]
    opacity = cfg["OPACITY"]
    title  = data.get("device_name", "")
    anc    = data.get("anc", "unknown")

    cell      = size // 3
    title_h   = int(cell * 0.35) if title else 0
    summary_h = int(cell * 0.28)
    anc_h     = int(cell * 0.75)
    W, H      = size, title_h + cell + summary_h + anc_h

    surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, W, H)
    ctx     = cairo.Context(surface)

    bg_r, bg_g, bg_b, _ = hex_to_rgba(bg)
    ctx.set_source_rgba(bg_r, bg_g, bg_b, opacity)
    ctx.rectangle(0, 0, W, H)
    ctx.fill()

    if title:
        ctx.set_source_rgba(*hex_to_rgba(text))
        ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        font_size = title_h * 0.55
        ctx.set_font_size(font_size)
        while ctx.text_extents(title).width > W * 0.90 and font_size > 6:
            font_size -= 0.5
            ctx.set_font_size(font_size)
        ext = ctx.text_extents(title)
        ctx.move_to(W / 2 - ext.width / 2 - ext.x_bearing,
                    title_h / 2 - ext.height / 2 - ext.y_bearing)
        ctx.show_text(title)

    accent_rgba  = hex_to_rgba(accent)
    ring_rgba    = hex_to_rgba(ring)
    text_rgba    = hex_to_rgba(text)
    bg_rgba      = hex_to_rgba(bg)
    sprite_surface, manifest = load_sprites(cfg["SPRITES_DIR"])

    visible = [(key, label) for key, label in GAUGE_LABELS if data.get(key, -1) >= 0]
    n         = max(len(visible), 1)
    col_w     = W / 3          # fixed sizing based on 3 columns
    pos_w     = W / n          # dynamic positioning
    radius    = col_w * 0.34
    thickness = max(4, col_w * 0.08)
    # cy must leave room for the badge circle above the ring: badge top = cy - radius - circle_r
    # circle_r ≈ radius * 0.333, so minimum cy = radius * 1.34; 0.50 * col_w gives safe clearance.
    cy        = title_h + col_w * 0.50

    if visible:
        for i, (key, label) in enumerate(visible):
            cx = pos_w * i + pos_w / 2
            draw_gauge(ctx, cx, cy, radius, thickness, data.get(key, -1), key, label,
                       ring_rgba, text_rgba, bg_rgba, sprite_surface, manifest,
                       data.get(f"{key}_charging", False), cfg["ICON_THEME"],
                       cfg["BATTERY_WARN"], cfg["BATTERY_CRITICAL"])
    else:
        for i, (key, label) in enumerate(GAUGE_LABELS):
            cx = (W / 3) * i + (W / 3) / 2
            _draw_unknown_gauge(ctx, cx, cy, radius, thickness, label, ring_rgba, text_rgba)

    # One label per visible gauge, centred on that gauge's cx
    label_map = {"left": "Left", "case": "Case", "right": "Right"}
    ctx.set_source_rgba(*text_rgba)
    ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
    ctx.set_font_size(max(9, cell * 0.14))
    summary_y = cy + radius + thickness + radius * 0.20
    for i, (key, _) in enumerate(visible):
        pct = data.get(key, -1)
        lbl = f"{label_map[key]}: {pct}%"
        cx  = pos_w * i + pos_w / 2
        ext_s = ctx.text_extents(lbl)
        ctx.move_to(cx - ext_s.width / 2 - ext_s.x_bearing, summary_y - ext_s.y_bearing)
        ctx.show_text(lbl)

    sep_y = title_h + cell + summary_h + anc_h * 0.04
    ctx.set_source_rgba(*(*text_rgba[:3], 0.15))
    ctx.set_line_width(1)
    ctx.set_dash([])
    ctx.move_to(W * 0.05, sep_y)
    ctx.line_to(W * 0.95, sep_y)
    ctx.stroke()

    draw_anc_row(ctx, W, title_h + cell + summary_h, anc_h, anc, accent_rgba, text_rgba,
                 cfg["ICON_THEME"], cfg.get("_ANC_SUPPORTED"))
    surface.write_to_png(OUTPUT_PATH)

# ── Notification ──────────────────────────────────────────────────────────────

def notify(cfg):
    subprocess.run([
        "dunstify",
        "--icon",    OUTPUT_PATH,
        "-r",        "801",
        "--hints",   "string:x-dunst-stack-tag:pbwidget",
        "--timeout", str(cfg["AUTO_CLOSE"]),
        "--appname", "pbwidget",
        "", "",
    ], check=False)

# ── Entry point ───────────────────────────────────────────────────────────────

def render_disconnected(cfg):
    size   = cfg["IMAGE_SIZE"]
    bg     = cfg["BG_COLOR"]
    text   = cfg["TEXT_COLOR"]
    opacity = cfg["OPACITY"]

    W = size
    H = size // 2
    surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, W, H)
    ctx     = cairo.Context(surface)

    bg_r, bg_g, bg_b, _ = hex_to_rgba(bg)
    ctx.set_source_rgba(bg_r, bg_g, bg_b, opacity)
    ctx.rectangle(0, 0, W, H)
    ctx.fill()

    sprite_surface, manifest = load_sprites(cfg["SPRITES_DIR"])
    if sprite_surface is not None and "disconnected" in manifest:
        sprite = manifest["disconnected"]
        sprite_h = H * 0.65
        scale = sprite_h / sprite["h"]
        draw_sprite(ctx, sprite_surface, sprite, W / 2, H * 0.46, scale)

    ctx.set_source_rgba(*hex_to_rgba(text))
    ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
    font_size = H * 0.14
    ctx.set_font_size(font_size)
    label = f"{cfg.get('_DEVICE_NAME', 'Pixel Buds')} disconnected."
    while ctx.text_extents(label).width > W * 0.92 and font_size > 6:
        font_size -= 0.5
        ctx.set_font_size(font_size)
    ext = ctx.text_extents(label)
    ctx.move_to(W / 2 - ext.width / 2 - ext.x_bearing,
                H * 0.90 - ext.y_bearing)
    ctx.show_text(label)

    surface.write_to_png(OUTPUT_PATH)


def main():
    os.makedirs(_RUNTIME_DIR, exist_ok=True)
    disconnected = "--disconnected" in sys.argv
    cfg  = load_config()

    if disconnected:
        cfg["_DEVICE_NAME"] = _lookup_device_name(cfg["DEVICE_MAC"]) or "Pixel Buds"
        render_disconnected(cfg)
        notify(cfg)
        return

    data = query_battery(cfg["DEVICE_MAC"])
    anc_state, anc_supported = query_anc(cfg["DEVICE_MAC"])
    data["anc"] = anc_state

    # Resolve which ANC modes to show:
    #   ANC_ADAPTIVE=auto  → use capabilities from device (default)
    #   ANC_ADAPTIVE=true  → always show adaptive
    #   ANC_ADAPTIVE=false → never show adaptive
    anc_adaptive_cfg = cfg["ANC_ADAPTIVE"]
    if anc_adaptive_cfg == "false":
        cfg["_ANC_SUPPORTED"] = _ALL_ANC_MODES - {"adaptive"}
    elif anc_adaptive_cfg == "true":
        cfg["_ANC_SUPPORTED"] = None  # show all 4
    else:  # auto
        if anc_supported:
            cfg["_ANC_SUPPORTED"] = anc_supported
        else:
            cfg["_ANC_SUPPORTED"] = _ALL_ANC_MODES - {"adaptive"}  # safe default: Adaptive is only on some models

    render(data, cfg)
    notify(cfg)

if __name__ == "__main__":
    main()
