#!/usr/bin/env python3
"""Pixel Buds battery + ANC status widget — renders a PNG and fires a dunst notification."""

import json
import math
import os
import re
import socket
import struct
import subprocess
import sys
import tempfile
import cairo
import gi
gi.require_version('Rsvg', '2.0')
from gi.repository import Rsvg

# ── Constants ────────────────────────────────────────────────────────────────

OUTPUT_PATH   = "/tmp/pbwidget.png"
EAR_TMP_PATH  = "/tmp/pbwidget-ear.svg"
RFCOMM_CH     = 2
ANC_STATES    = {0x80: "transparency", 0x40: "adaptive", 0x20: "off", 0x08: "noise_cancellation"}
GAUGE_LABELS  = [("left", "L"), ("case", "C"), ("right", "R")]
ANC_MODES     = [
    ("noise_cancellation", "Noise cancellation"),
    ("off",                "Off"),
    ("adaptive",           "Adaptive"),
    ("transparency",       "Transparency"),
]

EAR_SVG = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16"><path fill="gray" fill-rule="evenodd" d="M11.742.758a.5.5 0 0 0-.354.146.5.5 0 0 0 0 .707A5.5 5.5 0 0 1 13 5.5a5.503 5.503 0 0 1-1.621 3.879.5.5 0 0 0 0 .707.5.5 0 0 0 .707 0A6.497 6.497 0 0 0 14 5.502a.5.5 0 0 0 0-.002A6.5 6.5 0 0 0 12.096.904a.5.5 0 0 0-.354-.146zM7.5 1A4.5 4.5 0 0 0 3 5.5a.499.499 0 1 0 1 0A3.5 3.5 0 0 1 7.5 2 3.5 3.5 0 0 1 11 5.498a3.5 3.5 0 0 1 0 .002c-.002.67-.152 1.045-.371 1.346-.22.301-.541.537-.92.822-.758.57-1.69 1.435-1.71 3.326l.5.006H8a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.5c0-.277-.222-.5-.5-.5h-.025a.5.5 0 0 0-.474.5v.5a3 3 0 0 0 3 3 3 3 0 0 0 3-2.994A3 3 0 0 0 9 11c.018-1.604.582-1.983 1.312-2.533.366-.276.787-.568 1.125-1.033s.56-1.097.563-1.932l-.5-.002h.5A4.5 4.5 0 0 0 7.5 1zm0 3A1.5 1.5 0 0 0 6 5.5 1.5 1.5 0 0 0 7.5 7 1.5 1.5 0 0 0 9 5.5 1.5 1.5 0 0 0 7.5 4z"/></svg>'

# ── Config ───────────────────────────────────────────────────────────────────

_KV_RE = re.compile(r'^([A-Z_][A-Z0-9_]*)=(.+?)(?:\s+#.*)?$')

def _parse_env_file(path):
    result = {}
    try:
        with open(os.path.expanduser(path)) as f:
            for line in f:
                m = _KV_RE.match(line.strip())
                if m:
                    result[m.group(1)] = m.group(2).strip('"\'').strip()
    except OSError:
        pass
    return result

def load_config():
    cfg = _parse_env_file("~/.config/pbwidget/config.sh")
    env = _parse_env_file("~/.config/dotfiles/local.env")

    mac = (env.get("BT_PIXEL_BUDS_MAC")
           or cfg.get("DEVICE_MAC")
           or "AC:3E:B1:8E:4C:75")

    return {
        "DEVICE_MAC":   mac,
        "BG_COLOR":     cfg.get("BG_COLOR",    "#1e1e2e"),
        "TEXT_COLOR":   cfg.get("TEXT_COLOR",   "#cdd6f4"),
        "ACCENT_COLOR": cfg.get("ACCENT_COLOR", "#89b4fa"),
        "RING_COLOR":   cfg.get("RING_COLOR",   "#ffffff20"),
        "OPACITY":      float(cfg.get("OPACITY",    "0.0")),
        "AUTO_CLOSE":   int(cfg.get("AUTO_CLOSE",   "5000")),
        "IMAGE_SIZE":   int(cfg.get("IMAGE_SIZE",   "300")),
        "SPRITES_DIR":  os.path.expanduser("~/.config/pbwidget/images"),
    }

# ── Battery query ─────────────────────────────────────────────────────────────

def _extract_pct(line):
    m = re.search(r':\s*(\d+)%', line)
    return int(m.group(1)) if m else -1

def _extract_charging(line):
    return "(charging)" in line and "(not charging)" not in line

def query_battery(device_mac):
    pbpctrl = os.path.expanduser("~/.cargo/bin/pbpctrl")
    data = {"left": -1, "case": -1, "right": -1,
            "left_charging": False, "case_charging": False, "right_charging": False,
            "device_name": "", "anc": "unknown"}
    try:
        out = subprocess.check_output([pbpctrl, "show", "battery"],
                                      stderr=subprocess.DEVNULL, text=True)
    except Exception:
        return data

    for line in out.splitlines():
        if line.startswith("left bud:"):
            data["left"] = _extract_pct(line)
            data["left_charging"] = _extract_charging(line)
        elif line.startswith("right bud:"):
            data["right"] = _extract_pct(line)
            data["right_charging"] = _extract_charging(line)
        elif line.startswith("case:"):
            data["case"] = _extract_pct(line)
            data["case_charging"] = _extract_charging(line)

    try:
        bt_out = subprocess.check_output(["bluetoothctl", "devices"],
                                         stderr=subprocess.DEVNULL, text=True)
        for line in bt_out.splitlines():
            if device_mac and device_mac.upper() in line.upper():
                data["device_name"] = re.sub(r'^Device\s+\S+\s+', '', line).strip()
                break
        if not data["device_name"]:
            for line in bt_out.splitlines():
                if "pixel bud" in line.lower():
                    data["device_name"] = re.sub(r'^Device\s+\S+\s+', '', line).strip()
                    break
    except Exception:
        pass

    return data

# ── ANC query ─────────────────────────────────────────────────────────────────

def _read_rfcomm_msg(sock):
    h = b""
    while len(h) < 4:
        chunk = sock.recv(4 - len(h))
        if not chunk:
            raise ConnectionError("closed")
        h += chunk
    length = struct.unpack(">H", h[2:4])[0]
    p = b""
    while len(p) < length:
        chunk = sock.recv(length - len(p))
        if not chunk:
            raise ConnectionError("closed")
        p += chunk
    return h[0], h[1], p

def query_anc(mac):
    try:
        s = socket.socket(socket.AF_BLUETOOTH, socket.SOCK_STREAM, socket.BTPROTO_RFCOMM)
        s.settimeout(3)
        s.connect((mac, RFCOMM_CH))
        s.settimeout(0.4)
        try:
            while True:
                _read_rfcomm_msg(s)
        except (socket.timeout, ConnectionError):
            pass
        s.settimeout(3)
        s.send(bytes([0x08, 0x11, 0x00, 0x00]))
        g, c, p = _read_rfcomm_msg(s)
        s.close()
        if g == 0x08 and c == 0x13 and len(p) >= 4:
            return next((v for k, v in ANC_STATES.items() if p[3] & k), "unknown")
    except Exception:
        pass
    return "unknown"

# ── Rendering ─────────────────────────────────────────────────────────────────

def hex_to_rgba(h, alpha=1.0):
    h = h.lstrip("#")
    if len(h) == 8:
        r, g, b, a = (int(h[i:i+2], 16) / 255 for i in (0, 2, 4, 6))
        return r, g, b, a * alpha
    r, g, b = (int(h[i:i+2], 16) / 255 for i in (0, 2, 4))
    return r, g, b, alpha


def load_sprites(sprites_dir):
    try:
        surface = cairo.ImageSurface.create_from_png(f"{sprites_dir}/sprites.png")
        with open(f"{sprites_dir}/sprites.json") as f:
            manifest = json.load(f)
        return surface, manifest
    except Exception:
        return None, {}


def draw_sprite(ctx, sprite_surface, sprite, cx, cy, scale=1.0):
    x, y, w, h = sprite["x"], sprite["y"], sprite["w"], sprite["h"]
    dw, dh = w * scale, h * scale
    ctx.save()
    ctx.translate(cx - dw / 2, cy - dh / 2)
    ctx.scale(scale, scale)
    ctx.set_source_surface(sprite_surface, -x, -y)
    ctx.rectangle(0, 0, w, h)
    ctx.fill()
    ctx.restore()


def draw_gauge(ctx, cx, cy, radius, thickness, pct, key, label,
               accent, ring, text_color, sprite_surface, manifest, charging):
    ctx.set_line_cap(cairo.LINE_CAP_ROUND)
    ctx.set_line_width(thickness)

    ctx.set_source_rgba(*ring)
    ctx.new_sub_path()
    ctx.arc(cx, cy, radius, 0, 2 * math.pi)
    ctx.stroke()

    if pct > 0:
        start = -math.pi / 2
        end = start + (pct / 100) * 2 * math.pi
        ctx.set_source_rgba(*accent)
        ctx.new_sub_path()
        ctx.arc(cx, cy, radius, start, end)
        ctx.stroke()

    if sprite_surface is not None and key in manifest:
        sprite = manifest[key]
        inner = (radius - thickness / 2) * 2
        scale = (inner * 0.75) / max(sprite["w"], sprite["h"])
        draw_sprite(ctx, sprite_surface, sprite, cx, cy, scale)
    else:
        ctx.set_source_rgba(*text_color)
        ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        ctx.set_font_size(radius * 0.60)
        ext = ctx.text_extents(label)
        ctx.move_to(cx - ext.width / 2 - ext.x_bearing, cy - ext.height / 2 - ext.y_bearing)
        ctx.show_text(label)

    ctx.set_source_rgba(*text_color)
    ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
    ctx.set_font_size(radius * 0.34)
    pct_text = f"{pct}%" if pct >= 0 else "?"
    ext2 = ctx.text_extents(pct_text)
    pct_y = cy + radius + thickness + radius * 0.25
    ctx.move_to(cx - ext2.width / 2 - ext2.x_bearing, pct_y - ext2.y_bearing)
    ctx.show_text(pct_text)

    if charging and sprite_surface is not None and "flash" in manifest:
        flash = manifest["flash"]
        flash_cy = cy + radius * 0.45
        draw_sprite(ctx, sprite_surface, flash, cx, flash_cy)


_ear_handle = None

def _get_ear_handle():
    global _ear_handle
    if _ear_handle is None:
        if not os.path.exists(EAR_TMP_PATH):
            with open(EAR_TMP_PATH, "w") as f:
                f.write(EAR_SVG)
        _ear_handle = Rsvg.Handle.new_from_file(EAR_TMP_PATH)
    return _ear_handle


def draw_ear(ctx, cx, cy, r):
    handle = _get_ear_handle()
    dims = handle.get_intrinsic_dimensions()
    vb = dims.out_viewbox
    svg_w = vb.width if vb.width > 0 else 16.0
    svg_h = vb.height if vb.height > 0 else 16.0

    icon_size = r * 1.4
    px = max(1, int(icon_size))

    tmp = cairo.ImageSurface(cairo.FORMAT_ARGB32, px, px)
    tmp_ctx = cairo.Context(tmp)
    viewport = Rsvg.Rectangle()
    viewport.x, viewport.y, viewport.width, viewport.height = 0, 0, svg_w, svg_h
    tmp_ctx.scale(px / svg_w, px / svg_h)
    handle.render_document(tmp_ctx, viewport)

    r_col, g_col, b_col, a_col = ctx.get_source().get_rgba()
    ctx.save()
    ctx.set_source_rgba(r_col, g_col, b_col, a_col)
    ctx.mask_surface(tmp, cx - icon_size / 2, cy - icon_size / 2)
    ctx.restore()


def draw_anc_icon(ctx, cx, cy, r, mode_key, active_key, accent_rgba, text_rgba):
    is_active = mode_key == active_key
    color = accent_rgba if is_active else (*text_rgba[:3], 0.30)

    lw = max(1.5, r * 0.10)
    ctx.set_line_width(lw)
    ctx.set_line_cap(cairo.LINE_CAP_ROUND)
    ctx.set_source_rgba(*color)

    if mode_key == "noise_cancellation":
        ctx.set_dash([])
        ctx.new_sub_path()
        ctx.arc(cx, cy, r, 0, 2 * math.pi)
        ctx.stroke()

    elif mode_key == "off":
        unit = r * 0.35
        ctx.set_dash([unit, unit * 0.65])
        ctx.new_sub_path()
        ctx.arc(cx, cy, r, 0, 2 * math.pi)
        ctx.stroke()
        ctx.set_dash([])

    elif mode_key == "transparency":
        unit = r * 0.18
        ctx.set_dash([unit, unit * 0.9])
        ctx.new_sub_path()
        ctx.arc(cx, cy, r, 0, 2 * math.pi)
        ctx.stroke()
        ctx.set_dash([])

    elif mode_key == "adaptive":
        ctx.set_dash([])
        ctx.new_sub_path()
        ctx.arc(cx, cy, r, math.pi, 2 * math.pi)
        ctx.stroke()
        unit = r * 0.30
        ctx.set_dash([unit, unit * 0.65])
        ctx.new_sub_path()
        ctx.arc(cx, cy, r, 0, math.pi)
        ctx.stroke()
        ctx.set_dash([])

        star_cx, star_cy = cx + r * 0.72, cy - r * 0.72
        sr = r * 0.46
        sw = sr * 0.30
        ctx.set_line_width(0)
        for angle in (0, math.pi / 2):
            ctx.save()
            ctx.translate(star_cx, star_cy)
            ctx.rotate(angle)
            ctx.new_path()
            ctx.move_to(0, -sr)
            ctx.curve_to( sw, -sw,  sw,  sw, 0,  sr)
            ctx.curve_to(-sw,  sw, -sw, -sw, 0, -sr)
            ctx.close_path()
            ctx.fill()
            ctx.restore()

    ctx.set_source_rgba(*color)
    ctx.set_line_width(lw * 0.9)
    draw_ear(ctx, cx, cy, r)
    ctx.stroke()


def draw_anc_row(ctx, W, anc_y, anc_h, active_key, accent_rgba, text_rgba):
    cell = W // 4
    icon_r = anc_h * 0.28
    label_font = max(6, anc_h * 0.14)
    icon_cy = anc_y + anc_h * 0.42

    for i, (mode_key, mode_label) in enumerate(ANC_MODES):
        cx = cell * i + cell / 2
        draw_anc_icon(ctx, cx, icon_cy, icon_r, mode_key, active_key, accent_rgba, text_rgba)

        color = accent_rgba if mode_key == active_key else (*text_rgba[:3], 0.30)
        ctx.set_source_rgba(*color)
        ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL,
                             cairo.FONT_WEIGHT_BOLD if mode_key == active_key
                             else cairo.FONT_WEIGHT_NORMAL)
        ctx.set_font_size(label_font)

        words = mode_label.split()
        lines, cur = [], ""
        max_w = cell * 0.92
        for word in words:
            test = (cur + " " + word).strip()
            if ctx.text_extents(test).width <= max_w:
                cur = test
            else:
                if cur:
                    lines.append(cur)
                cur = word
        if cur:
            lines.append(cur)

        label_y = icon_cy + icon_r + anc_h * 0.10
        line_h = label_font * 1.3
        for j, line in enumerate(lines):
            ext = ctx.text_extents(line)
            ctx.move_to(cx - ext.width / 2 - ext.x_bearing,
                        label_y + j * line_h - ext.y_bearing)
            ctx.show_text(line)


def render(data, cfg):
    size   = cfg["IMAGE_SIZE"]
    bg     = cfg["BG_COLOR"]
    text   = cfg["TEXT_COLOR"]
    accent = cfg["ACCENT_COLOR"]
    ring   = cfg["RING_COLOR"]
    opacity = cfg["OPACITY"]
    title  = data.get("device_name", "")
    anc    = data.get("anc", "unknown")

    cell    = size // 3
    title_h = int(cell * 0.35) if title else 0
    anc_h   = int(cell * 0.75)
    W, H    = size, title_h + cell + anc_h

    surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, W, H)
    ctx     = cairo.Context(surface)

    bg_r, bg_g, bg_b, _ = hex_to_rgba(bg)
    ctx.set_source_rgba(bg_r, bg_g, bg_b, opacity)
    ctx.rectangle(0, 0, W, H)
    ctx.fill()

    if title:
        ctx.set_source_rgba(*hex_to_rgba(text))
        ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        font_size = title_h * 0.55
        ctx.set_font_size(font_size)
        while ctx.text_extents(title).width > W * 0.90 and font_size > 6:
            font_size -= 0.5
            ctx.set_font_size(font_size)
        ext = ctx.text_extents(title)
        ctx.move_to(W / 2 - ext.width / 2 - ext.x_bearing,
                    title_h / 2 - ext.height / 2 - ext.y_bearing)
        ctx.show_text(title)

    thickness    = max(4, cell * 0.08)
    radius       = cell * 0.34
    cy           = title_h + cell * 0.40
    accent_rgba  = hex_to_rgba(accent)
    ring_rgba    = hex_to_rgba(ring)
    text_rgba    = hex_to_rgba(text)
    sprite_surface, manifest = load_sprites(cfg["SPRITES_DIR"])

    for i, (key, label) in enumerate(GAUGE_LABELS):
        cx = cell * i + cell / 2
        draw_gauge(ctx, cx, cy, radius, thickness, data.get(key, -1), key, label,
                   accent_rgba, ring_rgba, text_rgba, sprite_surface, manifest,
                   data.get(f"{key}_charging", False))

    sep_y = title_h + cell + anc_h * 0.04
    ctx.set_source_rgba(*(*text_rgba[:3], 0.15))
    ctx.set_line_width(1)
    ctx.set_dash([])
    ctx.move_to(W * 0.05, sep_y)
    ctx.line_to(W * 0.95, sep_y)
    ctx.stroke()

    draw_anc_row(ctx, W, title_h + cell, anc_h, anc, accent_rgba, text_rgba)
    surface.write_to_png(OUTPUT_PATH)

# ── Notification ──────────────────────────────────────────────────────────────

def notify(cfg):
    subprocess.run([
        "dunstify",
        "--icon",    OUTPUT_PATH,
        "-r",        "801",
        "--hints",   "string:x-dunst-stack-tag:pbwidget",
        "--timeout", str(cfg["AUTO_CLOSE"]),
        "--appname", "pbwidget",
        "", "",
    ], check=False)

# ── Entry point ───────────────────────────────────────────────────────────────

def main():
    cfg  = load_config()
    data = query_battery(cfg["DEVICE_MAC"])
    data["anc"] = query_anc(cfg["DEVICE_MAC"])
    render(data, cfg)
    notify(cfg)

if __name__ == "__main__":
    main()
