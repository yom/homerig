#!/bin/bash
# Battery status notification daemon

readonly DISPLAY_ID="${DISPLAY_ID:-:0}"
readonly NOTIFICATION_ID="${NOTIFICATION_ID:-600}"
readonly NOTIFICATION_TIMEOUT="${NOTIFICATION_TIMEOUT:-5000}"
readonly BATTERY_DEVICE="${BATTERY_DEVICE:-BAT0}"
readonly AC_DEVICE="${AC_DEVICE:-AC}"
readonly KBD_BACKLIGHT_DEVICE="${KBD_BACKLIGHT_DEVICE:-tpacpi::kbd_backlight}"
readonly KBD_FLASH_DURATION="${KBD_FLASH_DURATION:-0.5}"
readonly AC_STATE_FILE="/tmp/battery-ac-state-$(whoami)"

readonly BATTERY_ICON_DIR="${BATTERY_ICON_DIR:-/usr/share/icons/Yaru/scalable/status}"

VERBOSE=false
X_USER=""

show_help() {
    echo "Usage: battery [-h] [-v]"
    echo "Options:"
    echo "    -h    Show this help message"
    echo "    -v    Enable verbose output"
    echo
    exit 0
}

log_debug() { [[ "$VERBOSE" == "true" ]] && echo "[DEBUG] $*" >&2; }
log_error() { echo "[ERROR] $*" >&2; }

flash_keyboard_backlight() {
    command -v brightnessctl >/dev/null 2>&1 || return 0
    brightnessctl --device "$KBD_BACKLIGHT_DEVICE" info >/dev/null 2>&1 || return 0

    local current_level
    current_level=$(brightnessctl --device "$KBD_BACKLIGHT_DEVICE" get 2>/dev/null || echo "0")
    sudo brightnessctl --device "$KBD_BACKLIGHT_DEVICE" set 2 >/dev/null 2>&1
    sleep "$KBD_FLASH_DURATION"
    sudo brightnessctl --device "$KBD_BACKLIGHT_DEVICE" set "$current_level" >/dev/null 2>&1
}

check_dependencies() {
    local missing=()
    for cmd in dunstify acpi; do
        command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
    done
    if [[ ${#missing[@]} -gt 0 ]]; then
        log_error "Missing required dependencies: ${missing[*]}"
        exit 1
    fi
    if [[ ! -d "/sys/class/power_supply/$BATTERY_DEVICE" ]]; then
        log_error "Battery device $BATTERY_DEVICE not found"; exit 1
    fi
    if [[ ! -d "/sys/class/power_supply/$AC_DEVICE" ]]; then
        log_error "AC adapter device $AC_DEVICE not found"; exit 1
    fi
}

detect_x_user() {
    if [[ "$(whoami)" != "root" ]]; then
        X_USER=$(whoami)
        export DISPLAY="${DISPLAY:-$DISPLAY_ID}"
        export XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}"
        return 0
    fi

    log_debug "Running as root, detecting X11 user session"
    X_USER=$(ps -eo user,comm 2>/dev/null | grep -E '(Xorg|X)$' | head -1 | awk '{print $1}' 2>/dev/null)

    if [[ -z "$X_USER" || "$X_USER" == "root" ]]; then
        X_USER=$(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $3}' | grep -v root | head -1 2>/dev/null)
    fi
    if [[ -z "$X_USER" ]]; then
        X_USER=$(ps -eo user,comm 2>/dev/null | grep -E '(gnome-session|kde|xfce|wmaker)' | head -1 | awk '{print $1}' 2>/dev/null)
    fi
    if [[ -z "$X_USER" && -S /tmp/.X11-unix/X0 ]]; then
        X_USER=$(stat -c %U /tmp/.X11-unix/X0 2>/dev/null)
    fi

    if [[ -n "$X_USER" && "$X_USER" != "root" ]]; then
        export DISPLAY="$DISPLAY_ID"
        export XAUTHORITY="/home/$X_USER/.Xauthority"
        log_debug "Detected X11 session for user: $X_USER"
    else
        log_error "No active X11 session found, exiting silently"
        exit 0
    fi
}

run_as_x_user() {
    if [[ "$(whoami)" == "root" && -n "$X_USER" && "$X_USER" != "root" ]]; then
        su - "$X_USER" -c "DISPLAY=$DISPLAY XAUTHORITY=$XAUTHORITY $(printf '%q ' "$@")" 2>/dev/null
    else
        "$@" 2>/dev/null
    fi
}

get_battery_info() {
    local battery_status ac_status capacity
    battery_status=$(cat "/sys/class/power_supply/$BATTERY_DEVICE/status" 2>/dev/null) \
        || { log_error "Failed to read battery status"; exit 1; }
    ac_status=$(cat "/sys/class/power_supply/$AC_DEVICE/online" 2>/dev/null) \
        || { log_error "Failed to read AC adapter status"; exit 1; }
    capacity=$(cat "/sys/class/power_supply/$BATTERY_DEVICE/capacity" 2>/dev/null) \
        || { log_error "Failed to read battery capacity"; exit 1; }
    log_debug "Battery: $battery_status, AC: $ac_status, Capacity: $capacity%"
    echo "${battery_status}|${ac_status}|${capacity}"
}

determine_battery_icon() {
    local state="$1" ac_online="$2" capacity="$3"
    local level suffix=""

    # Round down to nearest 10, clamped to [0, 100]
    level=$(( (capacity / 10) * 10 ))
    [[ $level -gt 100 ]] && level=100

    case "x$state" in
        xCharging)
            suffix="-charging" ;;
        "xNot charging"|xFull)
            [[ "$ac_online" == "1" ]] && suffix="-charged" ;;
        xDischarging|*)
            suffix="" ;;
    esac

    # battery-level-100-charged is the "plugged in, full" icon; skip -charged for lower levels
    [[ "$suffix" == "-charged" && $level -lt 100 ]] && suffix=""

    local icon="${BATTERY_ICON_DIR}/battery-level-${level}${suffix}-symbolic.svg"
    log_debug "Icon: $icon"
    echo "$icon"
}

show_battery_notification() {
    local icon="$1" battery_info
    battery_info=$(/usr/bin/acpi 2>/dev/null) || battery_info="Battery status unavailable"
    run_as_x_user dunstify -r "$NOTIFICATION_ID" -i "$icon" \
        -h string:x-canonical-private-synchronous:battery \
        -t "$NOTIFICATION_TIMEOUT" \
        "$battery_info"
}

show_gauge_notification() {
    local icon="$1"
    local time_info
    time_info=$(/usr/bin/acpi 2>/dev/null | awk -F', ' '{print $3}' | head -1)
    run_as_x_user dunstify -r "$NOTIFICATION_ID" -i "$icon" \
        -h string:x-canonical-private-synchronous:battery \
        -t "$NOTIFICATION_TIMEOUT" \
        "${time_info:-}"
}

main() {
    while getopts ":hv" opt; do
        case ${opt} in
            h) show_help ;;
            v) VERBOSE=true ;;
            \?) log_error "Invalid option: $OPTARG"; exit 1 ;;
        esac
    done
    shift $((OPTIND -1))

    check_dependencies
    detect_x_user

    local battery_info
    battery_info=$(get_battery_info)
    local battery_status="${battery_info%%|*}"
    local temp="${battery_info#*|}"
    local ac_status="${temp%%|*}"
    local capacity="${temp#*|}"

    local prev_ac="unknown"
    [[ -f "$AC_STATE_FILE" ]] && prev_ac=$(cat "$AC_STATE_FILE" 2>/dev/null)
    [[ "$prev_ac" == "0" && "$ac_status" == "1" ]] && flash_keyboard_backlight &
    echo "$ac_status" > "$AC_STATE_FILE" 2>/dev/null

    local icon=""
    if command -v battery-gauge >/dev/null 2>&1; then
        icon=$(run_as_x_user battery-gauge "$capacity" "$battery_status" "$ac_status" 2>/dev/null)
    fi
    if [[ -z "$icon" || ! -f "$icon" ]]; then
        log_debug "battery-gauge unavailable or failed; falling back to Yaru icon"
        icon=$(determine_battery_icon "$battery_status" "$ac_status" "$capacity")
        show_battery_notification "$icon"
    else
        log_debug "Gauge PNG: $icon"
        show_gauge_notification "$icon"
    fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
