#!/usr/bin/env python3
"""Persistent Pixel Buds Pro ANC state listener.

Keeps RFCOMM channel 2 open and calls /usr/local/bin/pbwidget whenever the
ANC state changes (noise_cancellation / transparency / adaptive / off).
Reconnects automatically with 5s backoff after any disconnection.
"""

import os
import re
import socket
import struct
import subprocess
import sys
import time

RFCOMM_CH  = 2
RECONNECT_DELAY = 5  # seconds
ANC_STATES = {0x80: "transparency", 0x40: "adaptive", 0x20: "off", 0x08: "noise_cancellation"}

_KV_RE = re.compile(r'^([A-Z_][A-Z0-9_]*)=(.+?)(?:\s+#.*)?$')

def _load_mac():
    for path in ("~/.config/dotfiles/local.env", "~/.config/pbwidget/config.sh"):
        try:
            with open(os.path.expanduser(path)) as f:
                for line in f:
                    m = _KV_RE.match(line.strip())
                    if m:
                        key = m.group(1)
                        val = m.group(2).strip('"\'').strip()
                        if key in ("BT_PIXEL_BUDS_MAC", "DEVICE_MAC") and val:
                            return val
        except OSError:
            pass
    return "AC:3E:B1:8E:4C:75"


def _read_msg(sock):
    h = b""
    while len(h) < 4:
        chunk = sock.recv(4 - len(h))
        if not chunk:
            raise ConnectionError("connection closed")
        h += chunk
    length = struct.unpack(">H", h[2:4])[0]
    p = b""
    while len(p) < length:
        chunk = sock.recv(length - len(p))
        if not chunk:
            raise ConnectionError("connection closed")
        p += chunk
    return h[0], h[1], p


def _connect(mac):
    s = socket.socket(socket.AF_BLUETOOTH, socket.SOCK_STREAM, socket.BTPROTO_RFCOMM)
    s.settimeout(10)
    s.connect((mac, RFCOMM_CH))

    # drain the initial device-info burst
    s.settimeout(0.4)
    try:
        while True:
            _read_msg(s)
    except (socket.timeout, ConnectionError):
        pass

    # request current ANC state immediately so we're in sync
    s.settimeout(10)
    s.send(bytes([0x08, 0x11, 0x00, 0x00]))
    s.settimeout(None)
    return s


def _decode_anc(payload):
    return next((v for k, v in ANC_STATES.items() if payload[3] & k), None)


def _trigger_widget():
    subprocess.run(["/usr/local/bin/pbwidget"], check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def run(mac):
    last_state = None
    print(f"bt-pixel-buds-anc: monitoring {mac}", flush=True)

    while True:
        try:
            print("bt-pixel-buds-anc: connecting...", flush=True)
            sock = _connect(mac)
            print("bt-pixel-buds-anc: connected", flush=True)

            while True:
                g, c, p = _read_msg(sock)
                if g == 0x08 and c == 0x13 and len(p) >= 4:
                    state = _decode_anc(p)
                    if state and state != last_state:
                        last_state = state
                        print(f"bt-pixel-buds-anc: ANC → {state}", flush=True)
                        _trigger_widget()

        except Exception as e:
            print(f"bt-pixel-buds-anc: {e} — retrying in {RECONNECT_DELAY}s", flush=True)
            try:
                sock.close()
            except Exception:
                pass
            time.sleep(RECONNECT_DELAY)


if __name__ == "__main__":
    run(_load_mac())
