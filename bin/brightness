#!/bin/bash

# Validate function parameter
FUNC=$1
if [ -z "$FUNC" ]; then
    echo "Usage: $0 {inc|dec}"
    exit 1
fi

# Check if required commands are available
if ! command -v brightnessctl >/dev/null 2>&1; then
    echo "Error: brightnessctl not found. Install with: sudo apt install brightnessctl"
    exit 1
fi

if ! command -v dunstify >/dev/null 2>&1; then
    echo "Error: dunstify not found. Install: sudo apt install dunst"
    exit 1
fi

# Configuration
STEP=5  # Brightness step in percentage

function getProgressString() {
    # getProgressString <TOTAL ITEMS> <FILLED LOOK> <NOT FILLED LOOK> <STATUS>
    # For instance:
    # $ getProgressString 10 "#" "-" 50
    # #####-----
    # Note: if you want to use | in your progress bar string you need to change the delimiter in the sed commands

    ITEMS="$1" # The total number of items(the width of the bar)
    FILLED_ITEM="$2" # The look of a filled item
    NOT_FILLED_ITEM="$3" # The look of a not filled item
    STATUS="$4" # The current progress status in percent

    # calculate how many items need to be filled and not filled
    FILLED_ITEMS=$(echo "((${ITEMS} * ${STATUS})/100 + 0.5) / 1" | bc)
    NOT_FILLED_ITEMS=$(echo "$ITEMS - $FILLED_ITEMS" | bc)

    # Assemble the bar string
    msg=$(printf "%${FILLED_ITEMS}s" | sed "s| |${FILLED_ITEM}|g")
    msg=${msg}$(printf "%${NOT_FILLED_ITEMS}s" | sed "s| |${NOT_FILLED_ITEM}|g")
    echo "$msg"
}

function getBrightnessIcon() {
    # getBrightnessIcon <BRIGHTNESS>

    BRIGHTNESS=$1

    # Use beautiful Paper theme notification brightness icons
    if [ $BRIGHTNESS -eq 0 ] ; then
        echo "/usr/share/icons/Paper/48x48/notifications/notification-display-brightness-off.svg"
    elif [ $BRIGHTNESS -le 33 ] ; then
        echo "/usr/share/icons/Paper/48x48/notifications/notification-display-brightness-low.svg"
    elif [ $BRIGHTNESS -le 66 ] ; then
        echo "/usr/share/icons/Paper/48x48/notifications/notification-display-brightness-medium.svg"
    else
        echo "/usr/share/icons/Paper/48x48/notifications/notification-display-brightness-full.svg"
    fi
}

# Get current brightness percentage
get_brightness_percentage() {
    local current_brightness max_brightness

    # Get current brightness value
    current_brightness=$(/usr/bin/brightnessctl get 2>/dev/null)
    if [ -z "$current_brightness" ]; then
        echo "Error: Failed to get current brightness"
        exit 1
    fi

    # Get maximum brightness value
    max_brightness=$(/usr/bin/brightnessctl max 2>/dev/null)
    if [ -z "$max_brightness" ]; then
        echo "Error: Failed to get maximum brightness"
        exit 1
    fi

    # Calculate percentage (using bc for floating point math)
    local percentage
    percentage=$(echo "scale=0; ($current_brightness * 100) / $max_brightness" | bc)
    echo "$percentage"
}

# Get device name for display in notification
get_device_name() {
    local device_info
    device_info=$(/usr/bin/brightnessctl info 2>/dev/null | head -1)
    if [[ "$device_info" =~ Device\ \'([^\']+)\' ]]; then
        echo "${BASH_REMATCH[1]}"
    else
        echo "Display"
    fi
}

case "x$FUNC" in
    "xinc")
        # Get current brightness to check limits
        CURRENT_BRIGHTNESS=$(get_brightness_percentage)
        if [ -n "$CURRENT_BRIGHTNESS" ] && [ "$CURRENT_BRIGHTNESS" -le $((100 - STEP)) ]; then
            /usr/bin/brightnessctl set ${STEP}%+ >/dev/null 2>&1
        else
            /usr/bin/brightnessctl set 100% >/dev/null 2>&1
        fi
    ;;
    "xdec")
        /usr/bin/brightnessctl set ${STEP}%- >/dev/null 2>&1
    ;;
    *)
        echo "Error: command not recognized"
        echo "Usage: $0 {inc|dec}"
        exit 1
    ;;
esac

# Get final brightness percentage
BRIGHTNESS=$(get_brightness_percentage)
if [ -z "$BRIGHTNESS" ]; then
    echo "Error: Failed to get brightness after adjustment"
    exit 1
fi

# Get device name
DEVICE_NAME=$(get_device_name)

dunstify -a brightness \
    -r 556 \
    -i $(getBrightnessIcon $BRIGHTNESS) \
    -h string:x-canonical-private-synchronous:brightness \
    -t 2000 \
    "$DEVICE_NAME" \
    "<b>$(getProgressString 20 "─" "·" $BRIGHTNESS) ${BRIGHTNESS}%</b>"